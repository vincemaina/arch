# Wallpaper candidates are generated for comparison and are large. Only the
# chosen one is tracked, and it lives under setup/dotfiles/ so it reaches the
# machine like any other dotfile.
docs/wallpapers/*.png

# Python bytecode, which appears whenever a helper script is imported
# for testing rather than executed.
__pycache__/
*.pyc

# The manual is built from docs/manual/*.md by tools/manual.sh. The chapters are
# tracked; the rendered HTML and the generated keyboard reference are not, since
# both are derived and one of them changes whenever a keybinding does.
docs/manual/build/

# Hook state is per session and means nothing to anyone else.
.claude/state/
