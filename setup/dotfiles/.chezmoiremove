# Paths chezmoi should delete from the target if present.
#
# Session units moved from graphical-session.target to wayland-session@sway.target
# so they stop under any compositor other than sway. Without this, the old enable
# symlinks stay behind on already-installed machines and the leak persists.
.config/systemd/user/graphical-session.target.wants

# Wallpapers used to be shipped as tracked PNGs, one per theme. They are now
# generated on the machine and named <theme>-<style>.png, so the old files are
# no longer written by anything and would otherwise sit in the target directory
# forever - chezmoi leaves files it does not manage alone rather than deleting
# them.
#
# The generated ones are deliberately NOT listed here. They are a cache: losing
# them costs a second and a half each, but chezmoi removing them on every apply
# would mean regenerating on every sync.
.local/share/wallpapers/deep-violet.png
.local/share/wallpapers/neon.png
.local/share/wallpapers/ember.png
.local/share/wallpapers/slate.png
