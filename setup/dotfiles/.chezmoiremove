# Paths chezmoi should delete from the target if present.
#
# Session units moved from graphical-session.target to wayland-session@sway.target
# so they stop under any compositor other than sway. Without this, the old enable
# symlinks stay behind on already-installed machines and the leak persists.
.config/systemd/user/graphical-session.target.wants

# The wallpaper is named after its theme now, so the one file that predated
# themes would otherwise sit in the target directory forever - chezmoi leaves
# files it does not manage alone rather than deleting them.
.local/share/wallpapers/deep-violet.png
