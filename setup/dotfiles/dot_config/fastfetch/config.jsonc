// fastfetch. Run it by hand for a system summary - it is no longer wired
// into anything automatic. TASK-113 removed greeting.service, which used to
// show this once at login.
//
// COLOURS
//
// These are ANSI colour names rather than hex, and that is the point: foot's
// sixteen ANSI colours are generated from the selected theme, so
// "cyan" here renders as the palette's accent and "magenta" as its secondary.
// Change the palette and this follows, with nothing to keep in step. Writing
// hex here would create a second place colours live.
//
// MODULES
//
// Trimmed to what is worth reading. The default output is long and mostly
// static; the lines kept are either things that change between logins - uptime,
// memory, swap, disk, package count - or things worth confirming are what you
// expect. Shell and terminal are omitted: they are always zsh and foot, and
// you are looking at the terminal already.
//
// GPU is kept on purpose: it names whatever is actually doing the rendering.
// On a virtual machine that is a virtio device driven in software - the
// situation recorded in DECISIONS.md under "The VM renders in software" - and
// seeing it at a glance beats discovering it later.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch",
        "padding": { "top": 1, "right": 3 }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "cyan",
            "title": "magenta"
        }
    },

    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name} at {host-name}"
        },
        {
            "type": "custom",
            "format": "───────────────────────────────"
        },
        { "type": "os",       "key": "distro " },
        { "type": "kernel",   "key": "kernel " },
        { "type": "uptime",   "key": "uptime " },
        { "type": "packages", "key": "packages" },
        { "type": "wm",       "key": "wm     " },
        "break",
        { "type": "cpu",      "key": "cpu    " },
        { "type": "gpu",      "key": "gpu    " },
        { "type": "memory",   "key": "memory " },
        { "type": "swap",     "key": "swap   " },
        { "type": "disk",     "key": "disk   " },
        "break",
        "colors",
        "break"
    ]
}
