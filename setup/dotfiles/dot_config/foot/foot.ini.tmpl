font=JetBrainsMono Nerd Font:size=10
pad=8x8

# Colours from .chezmoidata/palette.toml rather than foot's bundled gruvbox
# theme, so the terminal changes with the rest of the desktop instead of
# needing to be remembered separately.
#
# This replaces an include of tokyonight-night, which foot does not ship: the
# path resolved to nothing, foot silently used its defaults, and the terminal
# had no colour scheme at all.
[colors]
background={{ .palette.bg | trimPrefix "#" }}
foreground={{ .palette.text | trimPrefix "#" }}

regular0={{ .term.black }}
regular1={{ .term.red }}
regular2={{ .term.green }}
regular3={{ .term.yellow }}
regular4={{ .term.blue }}
regular5={{ .term.magenta }}
regular6={{ .term.cyan }}
regular7={{ .term.white }}

bright0={{ .term.bright_black }}
bright1={{ .term.bright_red }}
bright2={{ .term.bright_green }}
bright3={{ .term.bright_yellow }}
bright4={{ .term.bright_blue }}
bright5={{ .term.bright_magenta }}
bright6={{ .term.bright_cyan }}
bright7={{ .term.bright_white }}
