[main]
font=JetBrainsMono Nerd Font:size=10
pad=8x8

# Stated rather than relied upon. It is the default, but the palette here is
# dark-only, so being explicit means a change of default cannot quietly leave
# the terminal reading a [colors-light] section that does not exist.
initial-color-theme=dark

# Colours from .chezmoidata/palette.toml, so the terminal changes with the rest
# of the desktop rather than being remembered separately. This also means the
# palette is not limited to themes foot happens to ship, which is what broke it
# originally: the config included tokyonight-night, a theme foot does not have,
# so the path resolved to nothing and foot silently used its defaults.
#
# foot 1.26 renamed [colors] to [colors-dark], pairing it with [colors-light],
# and warns on every launch if the old name is used.
[colors-dark]
background={{ .palette.bg | trimPrefix "#" }}
foreground={{ .palette.text | trimPrefix "#" }}

regular0={{ .term.black }}
regular1={{ .term.red }}
regular2={{ .term.green }}
regular3={{ .term.yellow }}
regular4={{ .term.blue }}
regular5={{ .term.magenta }}
regular6={{ .term.cyan }}
regular7={{ .term.white }}

bright0={{ .term.bright_black }}
bright1={{ .term.bright_red }}
bright2={{ .term.bright_green }}
bright3={{ .term.bright_yellow }}
bright4={{ .term.bright_blue }}
bright5={{ .term.bright_magenta }}
bright6={{ .term.bright_cyan }}
bright7={{ .term.bright_white }}
