{{- $palette := index .themes .theme -}}
[main]
font={{ .font.family }}:size={{ .font.terminal }}
pad=16x16

# Stated rather than relied upon, and now it has something to state. foot picks
# between a [colors-dark] and a [colors-light] section, and this file writes
# exactly one of them - whichever the selected theme declares. The two have to
# agree: naming a section foot is not reading is the silent-no-op failure this
# repository keeps meeting, and it would show up as a terminal in stock colours.
initial-color-theme={{ $palette.mode }}

# Colours from the selected theme in .chezmoidata/themes.toml, so the terminal
# changes with the rest
# of the desktop rather than being remembered separately. This also means the
# palette is not limited to themes foot happens to ship, which is what broke it
# originally: the config included tokyonight-night, a theme foot does not have,
# so the path resolved to nothing and foot silently used its defaults.
#
# foot 1.26 renamed [colors] to [colors-dark], pairing it with [colors-light],
# and warns on every launch if the old name is used. Which of the two is written
# follows the theme, and initial-color-theme above selects the same one.
[colors-{{ $palette.mode }}]
# Background translucency, so the wallpaper shows faintly through a terminal.
#
# foot's own alpha rather than sway's `opacity`, which are not the same thing.
# sway fades the whole surface, glyphs included, and the text goes visibly
# duller for it. alpha fades only cells using the default background colour,
# so the text stays fully opaque and crisp. Compared side by side at the same
# 0.85 before choosing.
#
# Keep it subtle. The point is a hint of depth behind the terminal, not
# reading code through a wallpaper.
alpha=0.90

# The bell flash. warning rather than urgent: the palette reserves urgent for
# "something is wrong", and a bell is "attention, nothing wrong yet".
flash={{ $palette.warning | trimPrefix "#" }}
flash-alpha=0.4

background={{ $palette.bg | trimPrefix "#" }}
foreground={{ $palette.text | trimPrefix "#" }}

regular0={{ $palette.term.black }}
regular1={{ $palette.term.red }}
regular2={{ $palette.term.green }}
regular3={{ $palette.term.yellow }}
regular4={{ $palette.term.blue }}
regular5={{ $palette.term.magenta }}
regular6={{ $palette.term.cyan }}
regular7={{ $palette.term.white }}

bright0={{ $palette.term.bright_black }}
bright1={{ $palette.term.bright_red }}
bright2={{ $palette.term.bright_green }}
bright3={{ $palette.term.bright_yellow }}
bright4={{ $palette.term.bright_blue }}
bright5={{ $palette.term.bright_magenta }}
bright6={{ $palette.term.bright_cyan }}
bright7={{ $palette.term.bright_white }}

[bell]
# A terminal that has finished something should be able to say so.
#
# visual flashes the window itself, which is the signal when you are looking
# at it. notify raises a desktop notification through mako, and is the one
# that matters: it fires only when the window is unfocused, so a long build
# finishing on another workspace actually reaches you.
#
# notify-send comes from libnotify, declared in packages/desktop.txt. Without
# it, notify would silently do nothing.
visual=yes
notify=yes

[key-bindings]
# Select all - or the useful half of it. TASK-112.
#
# foot 1.27 has no select-all action: `man foot.ini` lists every key-bindings
# action and there is nothing that selects the buffer, nor any IPC to script a
# selection. What it does have is pipe-scrollback, which hands the whole
# buffer to a command. Since selecting everything in a terminal is nearly
# always the first half of copying everything, this does the copying and skips
# the highlight nobody can act on anyway.
#
# ~/.local/bin/terminal-copy-all trims the trailing blank rows off the grid,
# copies, and raises the notification that stands in for the missing
# highlight. It carries the full reasoning.
#
# Ctrl+Shift+A because Ctrl+Shift+C and Ctrl+Shift+V are already foot's own
# defaults for copy and paste, which is exactly the inference the task made.
# foot rejects a duplicate binding at parse time rather than silently
# preferring one - `foot --check-config` reports "already mapped to" and exits
# non-zero - so this having been accepted is itself the proof that Ctrl+Shift+A
# was free.
#
# ABSOLUTE PATH, AND WHY THIS FILE IS A .tmpl BEYOND THE COLOURS
#
# foot inherits the session's PATH, not an interactive shell's. ~/.local/bin is
# put on PATH by .zshrc, which applies to interactive shells only - so a bare
# `terminal-copy-all` here would resolve to nothing and the key would do
# nothing, silently. This is the same trap waybar's click commands document.
pipe-scrollback=[{{ .chezmoi.homeDir }}/.local/bin/terminal-copy-all] Control+Shift+a

# Machine-local overrides, loaded last. See the file itself for what belongs
# in it. [main] is re-opened deliberately: foot only accepts `include` in that
# section, and this was measured - an include inside [key-bindings] is rejected
# outright, while foot keeps parsing after an include, so last really is last.
[main]
include={{ .chezmoi.homeDir }}/.config/foot/local.ini
