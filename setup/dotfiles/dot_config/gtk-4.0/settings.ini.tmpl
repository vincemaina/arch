{{- $palette := index .themes .theme -}}
{{- $light := eq $palette.mode "light" -}}
# GTK's appearance, following whichever theme is selected.
#
# This file is a template because a theme declares `mode`, and GTK is the one
# surface where light and dark is a different theme rather than a different set
# of colours. The palette does not reach GTK - these applications get stock
# Adwaita either way - but which end of it they get does follow the desktop.
#
# THIS FILE IS THE LEVER, AND environment.d IS NOT
#
# GTK_THEME=Adwaita:dark used to sit in environment.d and pin this dark. It was
# removed, because an environment variable is read once when the process starts
# and environment.d is read once when the *user manager* starts - so a theme
# switch could not have moved GTK without a full re-login, and that is the
# reason the repository gave for refusing light themes at all.
#
# settings.ini is read by each GTK process as it starts, which is a much weaker
# form of "once": every application launched after a switch picks the new value
# up with no re-login. Verified rather than assumed - pavucontrol launched with
# GTK_THEME unset and this file naming Adwaita rendered light immediately.
#
# So the boundary is the one foot already has: new processes follow, running
# ones do not. run_onchange_after_reload-theme.sh closes the two cases where
# that would otherwise last a whole session, by restarting the polkit agent and
# the GTK portal - the only long-running GTK processes here that draw anything.
[Settings]
gtk-theme-name={{ if $light }}Adwaita{{ else }}Adwaita-dark{{ end }}
gtk-icon-theme-name={{ if $light }}Papirus{{ else }}Papirus-Dark{{ end }}
gtk-font-name=Noto Sans 10

# Ignored by GTK3 in favour of the theme name above, but respected by GTK4 and
# libadwaita applications, which have no theme to be told about.
gtk-application-prefer-dark-theme={{ if $light }}0{{ else }}1{{ end }}

gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=24
