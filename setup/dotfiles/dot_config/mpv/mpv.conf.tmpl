# mpv, configured for background audio rather than for video.
#
# WHY THE MPRIS LINE IS THE IMPORTANT ONE
#
# Without it mpv plays perfectly and nothing else on the desktop knows: the
# bar's media module shows nothing, and the playback keys - which all go through
# playerctl - control nothing. That is the "works, and the desktop cannot see
# it" shape this repository keeps meeting, and it is one line away.
#
# The plugin ships at a fixed path in the mpv-mpris package rather than in a
# directory mpv scans, so it has to be named.
script=/usr/lib/mpv-mpris/mpris.so

# Audio only. A radio stream has no video, but mpv still opens a window for the
# cover art some stations send, and a window is exactly what this feature exists
# to avoid.
video=no

# Keep the process alive when a stream drops rather than exiting, so a brief
# network blip does not silently end the music.
keep-open=yes

# Reconnect instead of giving up. Streams are long-lived and networks are not.
stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=30

# Modest cache: enough to ride out a stall, not enough to delay a station change.
cache=yes
demuxer-max-bytes=8MiB

# Machine-local overrides, included last so they win. Created once by chezmoi
# and never rewritten. A missing file is harmless here - measured: mpv exits 0
# with an include it cannot open.
include={{ .chezmoi.homeDir }}/.config/mpv/local.conf
