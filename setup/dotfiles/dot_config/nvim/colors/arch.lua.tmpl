{{- $palette := index .themes .theme -}}
-- The editor's colours, from the selected theme.
--
-- Generated from .chezmoidata/themes.toml like sway, the bar, foot, rofi, mako,
-- swaylock and the prompt. Edit the colours there, not here - this file is
-- rendered and will be overwritten.
--
-- SYNTAX USES THE ANSI COLOURS, CHROME USES THE ROLES
--
-- The palette has fifteen role colours chosen for a bar and a lock screen, and
-- sixteen ANSI colours chosen for a terminal. A syntax theme wants distinct
-- treatments for keywords, strings, functions, types and constants - which is
-- exactly what the ANSI sixteen already are, and exactly what the roles are
-- not. So syntax reads from `term` and the interface furniture reads from the
-- roles, and no new key has to be added to eight themes to make this work.
--
-- The comment colour is the one to be careful with. It is bright_black, which
-- every theme sets deliberately around 4.8:1 against the background rather than
-- the near-invisible grey that is conventional - checks/session.sh enforces
-- that floor, so comments here inherit a contrast that was already argued over.
--
-- THE BACKGROUND IS DELIBERATELY ABSENT
--
-- Normal has no background at all, so the terminal's own shows through. foot
-- runs at alpha 0.90, which means the editor gets the same slight transparency
-- as yazi, btop and every other terminal tool rather than painting an opaque
-- rectangle over the wallpaper and looking like the one thing that is not part
-- of the set.
--
-- The cost is that anything wanting to stand out has to do it with a colour
-- rather than by being a different shade of the same background - which is why
-- the selection and the completion menu below set theirs explicitly.

vim.cmd('highlight clear')
if vim.fn.exists('syntax_on') == 1 then
  vim.cmd('syntax reset')
end
vim.g.colors_name = 'arch'
-- Follows the theme's own declaration rather than being asserted here.
-- 'background' is not decoration: plugins and the built-in syntax defaults
-- branch on it, so an editor rendering a light palette while claiming to be
-- dark gets light-on-light from anything this file does not set explicitly.
vim.o.background = '{{ $palette.mode }}'

local p = {
  bg          = '{{ $palette.bg }}',
  bg_dim      = '{{ $palette.bg_dim }}',
  surface     = '{{ $palette.surface }}',
  surface_alt = '{{ $palette.surface_alt }}',
  muted       = '{{ $palette.muted }}',
  text        = '{{ $palette.text }}',
  text_dim    = '{{ $palette.text_dim }}',
  accent      = '{{ $palette.accent }}',
  secondary   = '{{ $palette.secondary }}',
  tertiary    = '{{ $palette.tertiary }}',
  ok          = '{{ $palette.ok }}',
  warning     = '{{ $palette.warning }}',
  urgent      = '{{ $palette.urgent }}',
  info        = '{{ $palette.info }}',
}

local t = {
  red     = '#{{ $palette.term.red }}',
  green   = '#{{ $palette.term.green }}',
  yellow  = '#{{ $palette.term.yellow }}',
  blue    = '#{{ $palette.term.blue }}',
  magenta = '#{{ $palette.term.magenta }}',
  cyan    = '#{{ $palette.term.cyan }}',
  comment = '#{{ $palette.term.bright_black }}',
}

local hl = function(group, spec) vim.api.nvim_set_hl(0, group, spec) end

-- ---------------------------------------------------------------------------
-- The editor itself
-- ---------------------------------------------------------------------------

-- bg = 'NONE' rather than an omitted key: omitting it inherits, naming NONE is
-- what actually clears it and lets the terminal through.
hl('Normal',       { fg = p.text, bg = 'NONE' })
hl('NormalFloat',  { fg = p.text, bg = p.surface })
hl('FloatBorder',  { fg = p.surface_alt, bg = p.surface })
hl('NormalNC',     { fg = p.text, bg = 'NONE' })

hl('LineNr',       { fg = p.muted })
hl('CursorLineNr', { fg = p.accent, bold = true })
-- The cursor line is a background, and with a transparent Normal it is the only
-- thing marking where you are - so it is a real colour rather than a tint of
-- something that is no longer there.
hl('CursorLine',   { bg = p.surface })
hl('SignColumn',   { bg = 'NONE' })
hl('ColorColumn',  { bg = p.surface })
hl('Visual',       { bg = p.surface_alt })
hl('MatchParen',   { fg = p.accent, bold = true })

hl('Search',       { fg = p.bg, bg = p.warning })
hl('IncSearch',    { fg = p.bg, bg = p.accent })
hl('CurSearch',    { fg = p.bg, bg = p.accent })

hl('StatusLine',   { fg = p.text, bg = p.surface })
hl('StatusLineNC', { fg = p.muted, bg = p.bg_dim })
hl('WinSeparator', { fg = p.surface_alt })
hl('VertSplit',    { fg = p.surface_alt })

hl('Folded',       { fg = p.muted, bg = p.surface })
hl('NonText',      { fg = p.surface_alt })
hl('Whitespace',   { fg = p.surface_alt })
hl('EndOfBuffer',  { fg = p.surface_alt })
hl('Directory',    { fg = p.accent })
hl('Title',        { fg = p.secondary, bold = true })
hl('Question',     { fg = p.ok })
hl('ModeMsg',      { fg = p.accent, bold = true })
hl('MoreMsg',      { fg = p.ok })
hl('WarningMsg',   { fg = p.warning })
hl('ErrorMsg',     { fg = p.urgent })

-- The completion menu. It has to be opaque: a translucent popup over
-- translucent text is unreadable, which is the one place the transparency has
-- to stop.
hl('Pmenu',        { fg = p.text, bg = p.surface })
hl('PmenuSel',     { fg = p.bg, bg = p.accent, bold = true })
hl('PmenuSbar',    { bg = p.surface })
hl('PmenuThumb',   { bg = p.surface_alt })
hl('PmenuKind',    { fg = p.info, bg = p.surface })
hl('PmenuExtra',   { fg = p.muted, bg = p.surface })

hl('TabLine',      { fg = p.muted, bg = p.bg_dim })
hl('TabLineSel',   { fg = p.text, bg = p.surface, bold = true })
hl('TabLineFill',  { bg = 'NONE' })

-- ---------------------------------------------------------------------------
-- Syntax
-- ---------------------------------------------------------------------------

hl('Comment',      { fg = t.comment, italic = true })
hl('Constant',     { fg = t.yellow })
hl('String',       { fg = t.green })
hl('Character',    { fg = t.green })
hl('Number',       { fg = t.yellow })
hl('Boolean',      { fg = t.yellow })
hl('Float',        { fg = t.yellow })

hl('Identifier',   { fg = p.text })
hl('Function',     { fg = t.blue })

hl('Statement',    { fg = t.magenta })
hl('Conditional',  { fg = t.magenta })
hl('Repeat',       { fg = t.magenta })
hl('Label',        { fg = t.magenta })
hl('Operator',     { fg = p.text_dim })
hl('Keyword',      { fg = t.magenta })
hl('Exception',    { fg = t.red })

hl('PreProc',      { fg = t.cyan })
hl('Include',      { fg = t.magenta })
hl('Define',       { fg = t.magenta })
hl('Macro',        { fg = t.cyan })

hl('Type',         { fg = t.cyan })
hl('StorageClass', { fg = t.cyan })
hl('Structure',    { fg = t.cyan })
hl('Typedef',      { fg = t.cyan })

hl('Special',      { fg = t.red })
hl('SpecialChar',  { fg = t.red })
hl('Delimiter',    { fg = p.text_dim })
hl('SpecialComment', { fg = t.comment, bold = true })
hl('Todo',         { fg = p.bg, bg = p.warning, bold = true })
hl('Underlined',   { fg = p.info, underline = true })
hl('Error',        { fg = p.urgent })

-- ---------------------------------------------------------------------------
-- Treesitter
-- ---------------------------------------------------------------------------
--
-- Linked rather than restated. Treesitter's capture names are far more specific
-- than vim's groups, and giving each its own colour is how a theme ends up with
-- forty shades nobody can tell apart. Linking means the mapping above is the
-- only place colours are decided.

local links = {
  ['@comment']              = 'Comment',
  ['@string']               = 'String',
  ['@string.escape']        = 'SpecialChar',
  ['@string.special']       = 'SpecialChar',
  ['@character']            = 'Character',
  ['@number']               = 'Number',
  ['@boolean']              = 'Boolean',
  ['@float']                = 'Float',
  ['@constant']             = 'Constant',
  ['@constant.builtin']     = 'Constant',
  ['@function']             = 'Function',
  ['@function.call']        = 'Function',
  ['@function.builtin']     = 'Function',
  ['@function.method']      = 'Function',
  ['@constructor']          = 'Type',
  ['@keyword']              = 'Keyword',
  ['@keyword.function']     = 'Keyword',
  ['@keyword.return']       = 'Keyword',
  ['@keyword.operator']     = 'Operator',
  ['@conditional']          = 'Conditional',
  ['@repeat']               = 'Repeat',
  ['@exception']            = 'Exception',
  ['@type']                 = 'Type',
  ['@type.builtin']         = 'Type',
  ['@type.definition']      = 'Typedef',
  ['@attribute']            = 'PreProc',
  ['@property']             = 'Identifier',
  ['@field']                = 'Identifier',
  ['@variable']             = 'Identifier',
  ['@variable.builtin']     = 'Special',
  ['@variable.parameter']   = 'Identifier',
  ['@operator']             = 'Operator',
  ['@punctuation.delimiter'] = 'Delimiter',
  ['@punctuation.bracket']  = 'Delimiter',
  ['@punctuation.special']  = 'SpecialChar',
  ['@tag']                  = 'Statement',
  ['@tag.attribute']        = 'Identifier',
  ['@tag.delimiter']        = 'Delimiter',
  ['@markup.heading']       = 'Title',
  ['@markup.link']          = 'Underlined',
  ['@markup.raw']           = 'String',
  ['@markup.list']          = 'Statement',
  -- Unnamed until TASK-199, and it showed: the words inside a block quote fell
  -- through to nvim's own default and arrived salmon, which on a rendered
  -- document reads as an error rather than as a quotation. A quote is set back
  -- from the text around it, so it takes the same treatment as a comment.
  ['@markup.quote']         = 'Comment',
}

for from, to in pairs(links) do
  hl(from, { link = to })
end

-- ---------------------------------------------------------------------------
-- Diagnostics and LSP
-- ---------------------------------------------------------------------------
--
-- The four severities map onto the four the palette already defines for the
-- rest of the desktop, so an error in the editor is the same red as an urgent
-- notification and a battery about to die.

hl('DiagnosticError', { fg = p.urgent })
hl('DiagnosticWarn',  { fg = p.warning })
hl('DiagnosticInfo',  { fg = p.info })
hl('DiagnosticHint',  { fg = p.muted })
hl('DiagnosticOk',    { fg = p.ok })

hl('DiagnosticUnderlineError', { sp = p.urgent, undercurl = true })
hl('DiagnosticUnderlineWarn',  { sp = p.warning, undercurl = true })
hl('DiagnosticUnderlineInfo',  { sp = p.info, undercurl = true })
hl('DiagnosticUnderlineHint',  { sp = p.muted, undercurl = true })

-- Where the same symbol appears elsewhere in the file, which the LSP reports
-- as you rest the cursor. A background rather than a colour, so it does not
-- fight whatever the syntax already made it.
hl('LspReferenceText',  { bg = p.surface })
hl('LspReferenceRead',  { bg = p.surface })
hl('LspReferenceWrite', { bg = p.surface_alt })

-- ---------------------------------------------------------------------------
-- Diff and git
-- ---------------------------------------------------------------------------

hl('DiffAdd',    { fg = p.ok })
hl('DiffChange', { fg = p.warning })
hl('DiffDelete', { fg = p.urgent })
hl('DiffText',   { fg = p.bg, bg = p.warning })
hl('Added',      { fg = p.ok })
hl('Changed',    { fg = p.warning })
hl('Removed',    { fg = p.urgent })

-- ---------------------------------------------------------------------------
-- Rendered markdown
-- ---------------------------------------------------------------------------
--
-- render-markdown.nvim (TASK-199, see lua/plugins.lua). It ships its own
-- defaults for all of these as links to groups it hopes a colourscheme has -
-- DiffText for the level-one heading background, DiffAdd for level two - and
-- this theme sets those two to a foreground and nothing else, so headings would
-- have arrived with one yellow band and five invisible ones.
--
-- EVERY GROUP IS NAMED HERE, not only the wrong ones, and that is deliberate.
-- `:colorscheme` begins with `highlight clear`, which drops the plugin's
-- defaults, and the plugin re-derives only its computed colours afterwards -
-- not the base links. A group this file does not name is therefore fine until
-- the theme is switched and then quietly gone. That is precisely the shape of
-- failure this repository keeps finding, so the list is exhaustive on purpose.
-- The one exception is the heading backgrounds on a light theme, which are left
-- undefined deliberately and unavoidably - see the note above the loop.
--
-- THE ROLE COLOURS ARE NOT ALL SAFE AS FOREGROUNDS. `tertiary` is a background
-- on the light themes - on `paper` it is #c9c9c2, the focused workspace disc
-- with dark text on it - so a heading painted with it would be legible on eight
-- themes and invisible on three. Headings use `accent` and the ANSI colours,
-- which every theme guarantees are readable against its own background.

-- One table, read twice. The heading's icon and its full-width band come from
-- the plugin; the heading TEXT comes from treesitter, and if the two were
-- listed separately they would drift the first time a level was recoloured.
local headings = {
  { fg = p.accent,   bg = p.surface_alt },
  { fg = t.magenta,  bg = p.surface },
  { fg = t.blue,     bg = p.surface },
  { fg = t.cyan,     bg = p.surface },
  { fg = t.green,    bg = p.surface },
  { fg = p.text_dim, bg = p.surface },
}

-- THE BAND IS A DARK-THEME FEATURE, and this is measured rather than a taste.
--
-- A band moves the background under the heading toward mid-grey. On a dark
-- theme that is away from the text and costs about a point of contrast; on a
-- light theme it is toward the text, and `sepia` fell from 4.69:1 to 3.41:1 for
-- its level-one heading and 4.05:1 for level two - under the 4.5:1 floor this
-- palette holds everything else to, and worse than the plain background it
-- replaced. Every dark theme stays at 4.8:1 or better banded; every light theme
-- is at 4.69:1 or better without.
--
-- So it is the same shape of decision the bar's `glow` already is, for the same
-- reason: bright light needs somewhere dark to be bright against. A light theme
-- still gets the icon and the coloured, bold heading text - which is what makes
-- it read as a heading - just not the bar behind it.
--
-- The code panel below is NOT treated this way, and the difference is not an
-- inconsistency. It uses `surface`, which `CursorLine` already puts behind a
-- whole line of ordinary text on every theme, so a fenced block is no harder to
-- read than the line the cursor happens to be on - it costs nothing that was
-- not already being paid. The band is a step further out, to `surface_alt`,
-- and it lands under `accent` and `magenta`, which are where these palettes
-- have the least headroom.
--
-- TURNING IT OFF IS NOT DONE HERE, and the attempt is worth recording. Clearing
-- the group is the obvious move and does not work: nvim treats both `{}` and
-- `{ bg = 'NONE' }` as leaving RenderMarkdownH1Bg UNDEFINED, so the plugin's own
-- `default = true` link survives and the heading renders with DiffText's
-- background - the warning colour, full width, on every light theme. Measured by
-- asking a running editor, after writing it the wrong way twice. So the light
-- themes leave these groups alone and lua/plugins.lua tells the plugin it has no
-- background groups at all, which skips the render rather than colouring it.
local banded = {{ if eq $palette.mode "dark" }}true{{ else }}false{{ end }}

for level, h in ipairs(headings) do
  -- The icon, and with `position = 'overlay'` the '#'s it covers.
  hl('RenderMarkdownH' .. level, { fg = h.fg, bold = true })
  -- The band, which runs the full width of the window. Opaque, unlike Normal:
  -- a heading that let the wallpaper through would not read as a heading.
  if banded then
    hl('RenderMarkdownH' .. level .. 'Bg', { bg = h.bg })
  end
  -- The words. Backgroundless, so the band above shows through rather than
  -- being cut off where the text ends.
  hl('@markup.heading.' .. level .. '.markdown', { fg = h.fg, bold = true })
end

-- Code. `surface` is this palette's one raised-panel shade - the cursor line
-- and the completion menu are already wearing it - so a fenced block sits in
-- the same plane as everything else that is lifted off the background.
hl('RenderMarkdownCode',         { bg = p.surface })
hl('RenderMarkdownCodeBorder',   { bg = p.surface })
hl('RenderMarkdownCodeInline',   { bg = p.surface })
hl('RenderMarkdownCodeInfo',     { fg = p.muted })
hl('RenderMarkdownCodeFallback', { fg = p.text })

-- `==this==`, which is a highlighter pen and should look like one. Same
-- treatment as a search match, for the same reason: it marks, it does not
-- decorate.
hl('RenderMarkdownInlineHighlight', { fg = p.bg, bg = p.warning })

hl('RenderMarkdownBullet', { fg = p.accent })
-- A thematic break is drawn across the whole window, so it takes the separator
-- colour rather than the line-number colour the plugin defaults to - at full
-- width `muted` stops being a rule and becomes a stripe.
hl('RenderMarkdownDash',        { fg = p.surface_alt })
hl('RenderMarkdownIndent',      { fg = p.surface_alt })
hl('RenderMarkdownSign',        { fg = p.muted })
hl('RenderMarkdownMath',        { fg = t.cyan })
hl('RenderMarkdownHtmlComment', { fg = t.comment, italic = true })

-- Links. The title is underlined and the icon is not, so the icon reads as a
-- marker rather than as part of the text you would follow.
hl('RenderMarkdownLink',      { fg = p.info })
hl('RenderMarkdownWikiLink',  { fg = p.info })
hl('RenderMarkdownLinkTitle', { fg = p.info, underline = true })

hl('RenderMarkdownUnchecked', { fg = p.muted })
hl('RenderMarkdownChecked',   { fg = p.ok })
hl('RenderMarkdownTodo',      { fg = p.warning })

-- The quote bar, at every nesting depth. All six named rather than left to the
-- plugin's own Quote1..Quote6 -> Quote links, which `highlight clear` takes.
hl('RenderMarkdownQuote', { fg = p.muted })
for level = 1, 6 do
  hl('RenderMarkdownQuote' .. level, { link = 'RenderMarkdownQuote' })
end

hl('RenderMarkdownTableHead', { fg = p.secondary, bold = true })
hl('RenderMarkdownTableRow',  { fg = p.muted })

-- Callouts - > [!NOTE] and friends - stay linked to the diagnostics above, so a
-- warning in a document is the same amber as a warning from a language server
-- and a battery about to die. Links rather than colours: the mapping is decided
-- once, further up this file.
hl('RenderMarkdownSuccess', { link = 'DiagnosticOk' })
hl('RenderMarkdownInfo',    { link = 'DiagnosticInfo' })
hl('RenderMarkdownHint',    { link = 'DiagnosticHint' })
hl('RenderMarkdownWarn',    { link = 'DiagnosticWarn' })
hl('RenderMarkdownError',   { link = 'DiagnosticError' })
