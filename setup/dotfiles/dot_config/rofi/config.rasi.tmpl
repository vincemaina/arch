/* rofi.
 *
 * Colours come from .chezmoidata/palette.toml. Edit them there, not here.
 *
 * The point of using rofi rather than a simpler launcher is `combi`: several
 * sources behind one prompt, so there is one thing to reach for regardless of
 * whether the answer is an application, a window, a file or a sum.
 */

configuration {
    modes: "combi";

    /* The sources combi merges. drun is applications by their desktop entry,
     * window jumps to something already open, calc is rofi-calc, and
     * filebrowser walks the filesystem. */
    combi-modes: "drun,window,calc,filebrowser";

    show-icons:   true;
    display-combi: "";
    terminal:     "foot";
}

* {
    bg:       {{ .palette.bg }};
    surface:  {{ .palette.surface }};
    text:     {{ .palette.text }};
    text-dim: {{ .palette.text_dim }};
    accent:   {{ .palette.accent }};
    urgent:   {{ .palette.urgent }};

    background-color: transparent;
    text-color:       @text;
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    width:            42em;
    padding:          0;
}

inputbar {
    background-color: @surface;
    padding:          10px 12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding:    0 8px 0 0;
}

listview {
    lines:   12;
    padding: 6px;
}

element {
    padding: 6px 10px;
}

element selected {
    background-color: @accent;
    text-color:       @bg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

element-icon {
    size:    1.1em;
    padding: 0 8px 0 0;
}
