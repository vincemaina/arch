{{- $palette := index .themes .theme -}}
/* rofi.
 *
 * Colours come from the selected theme in .chezmoidata/themes.toml. Edit them
 * there, not here.
 *
 * The point of rofi over a simpler launcher is `combi`: several sources behind
 * one prompt, so there is one thing to reach for whether the answer is an
 * application, a window, a file or a sum.
 *
 * Every element below sets its own colours explicitly rather than relying on
 * the `*` block. rofi loads its own theme first and sets colours on *named*
 * elements, and a named rule beats a wildcard - so a `*` block alone leaves
 * the list rendering in rofi's stock cream, which is exactly what happened.
 */

configuration {
    modes: "combi";

    /* Applications, windows already open, and a sum. Deliberately not files.
     *
     * Files were merged in here and taken back out. Home holds thousands of
     * them against 32 applications, so they drown the list however hard it is
     * filtered - and the filtering itself is a losing game, since every new
     * application invents another state directory to exclude.
     *
     * Finding a file is instead an entry *in* this list, like Notifications:
     * type "find" and it opens the file finder. That keeps one thing to
     * remember while keeping the launcher small enough to be scanned. */
    combi-modes: "drun,window,calc";

    /* Fuzzy so a few characters from anywhere in the name are enough, and fzf
     * ordering so the best match rises rather than the alphabetically first.
     * Recency is separate and already on: rofi keeps a history per mode
     * (disable-history is false by default), which is why the last thing
     * launched sits at the top of an empty prompt. */
    matching:       "fuzzy";
    sort:           true;
    sorting-method: "fzf";

    /* Searches recursively from home and opens the result, so a file goes to
     * the right program and a directory goes to the file manager. This is the
     * "find a file" mode; filebrowser is the "walk the tree" one.
     *
     * `gio open` rather than `xdg-open`, and that is the difference between
     * this working and doing nothing at all.
     *
     * xdg-open is a shell script that picks a strategy from the detected
     * desktop environment. Sway is not one it recognises, so it takes the
     * generic path - and the generic path parses the .desktop file itself and
     * executes the command directly, ignoring Terminal=true completely. From a
     * terminal that is arguably right: `xdg-open notes.md` opening the editor
     * in the terminal you typed it in is what you wanted. From a launcher there
     * is no terminal, so nvim starts, finds no tty and dies, and nothing is
     * reported anywhere.
     *
     * gio is glib's own implementation and honours Terminal=true properly: it
     * looks for xdg-terminal-exec on PATH, which is why ~/.local/bin ships one
     * and why environment.d puts that directory on the session PATH.
     *
     * Traced rather than guessed - `bash -x xdg-open file.py` ends in
     * `env nvim /tmp/file.py` with no terminal anywhere in sight. */
    recursivebrowser {
        directory: "~";
        command:   "gio open";

        /* Application state, caches, repository internals and dependency
         * directories - none of them things anyone searches for by name, and
         * between them the bulk of the file count.
         *
         * .local/share is in the list because that is where applications keep
         * their working state: searching for "notif" was surfacing
         * qutebrowser's Platform Notifications LOG, LOCK and MANIFEST files.
         * Desktop entries live there too but come from drun rather than from
         * here, so excluding it costs nothing. */
        filter-regex: ".*/(\.git|\.cache|\.local/share|\.local/state|\.mozilla|\.pki|node_modules|__pycache__|target|\.venv)/.*";
    }

    /* Without this every row is prefixed with the mode that produced it -
     * "drun Firefox" - which is noise when the icon already says as much. */
    combi-hide-mode-prefix: true;

    /* The prompt is rofi's mode name by default, so it read "combi" and
     * "recursivebrowser" - internal vocabulary on screen. */
    display-combi:            "run";

    show-icons: true;
    terminal:   "foot";
    drun-display-format: "{name}";
}

* {
    bg:        {{ $palette.bg }};
    surface:   {{ $palette.surface }};
    surface-alt: {{ $palette.surface_alt }};
    text:      {{ $palette.text }};
    text-dim:  {{ $palette.text_dim }};
    muted:     {{ $palette.muted }};
    accent:    {{ $palette.accent }};
    secondary: {{ $palette.secondary }};
    urgent:    {{ $palette.urgent }};

    /* rofi's own colour variables. Setting these is the point: the stock
     * theme's rules are state-specific - `element normal.normal` and friends -
     * and a state rule beats a plain `element` rule, so overriding `element`
     * alone left the list rendering in rofi's cream. Found by asking
     * `rofi -dump-theme` what it had actually applied. */
    background:                  transparent;
    foreground:                  @text;
    separatorcolor:              @surface-alt;
    lightbg:                     @surface;
    lightfg:                     @text;
    blue:                        @accent;
    red:                         @urgent;

    normal-background:           transparent;
    normal-foreground:           @text-dim;
    alternate-normal-background: transparent;
    alternate-normal-foreground: @text-dim;
    selected-normal-background:  @accent;
    selected-normal-foreground:  @bg;

    /* Something already open, rather than something to launch. */
    active-background:           transparent;
    active-foreground:           @secondary;
    alternate-active-background: transparent;
    alternate-active-foreground: @secondary;
    selected-active-background:  @secondary;
    selected-active-foreground:  @bg;

    urgent-background:           transparent;
    urgent-foreground:           @urgent;
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: @urgent;
    selected-urgent-background:  @urgent;
    selected-urgent-foreground:  @bg;

    background-color: transparent;
    text-color:       @text;
    spacing:          0;
}

window {
    /* Slightly transparent, matching the terminals. Alpha is the last two hex
     * digits: e8 is about 91%. rofi has no blur of its own and cannot get one
     * here - the word does not appear in rofi-theme(5), and blur needs the
     * compositor to implement ext-background-effect-v1, which sway does not.
     * Same answer as foot. */
    background-color: {{ $palette.bg }}e8;
    border:           4px;
    border-color:     @accent;
    /* Square, like everything else. sway draws flat rectangular borders and
     * foot has no rounding, so a rounded launcher was the one thing on screen
     * with a different shape language. */
    border-radius:    0;
    width:            40em;
    padding:          0;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    padding:          0;
}

/* The prompt reads as one bar rather than a box inside a box: the surface
 * colour separates it from the list without drawing a line. */
inputbar {
    background-color: {{ $palette.surface }}cc;
    text-color:       @text;
    padding:          8px 12px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "search";
    placeholder-color: @muted;
    cursor:           text;
}

listview {
    background-color: transparent;
    /* More rows, each smaller. The list is for scanning, so fitting more of it
     * on screen beats making any single row comfortable to read slowly. */
    lines:            14;
    padding:          4px;
    scrollbar:        false;
    dynamic:          true;
    fixed-height:     false;
}

element {
    background-color: transparent;
    text-color:       @text-dim;
    /* Tight. The default 7px vertical made each row about 40px tall, which
     * reads as a touch target rather than a list and pushes most of the
     * results off screen. */
    padding:          3px 8px;
    spacing:          8px;
    cursor:           pointer;
}

/* Only the selected row is loud. Everything else is the same quiet surface,
 * the same reasoning as the sway borders: where you are should be visible
 * without reading anything. */
element selected {
    background-color: @accent;
    text-color:       @bg;
}

/* Something already open, as opposed to something to launch. Given the
 * secondary colour so the two sources are distinguishable at a glance now
 * that the mode prefix is hidden. */
element urgent {
    background-color: @bg;
    text-color:       @urgent;
}

element active {
    background-color: @bg;
    text-color:       @secondary;
}

element selected active {
    background-color: @secondary;
    text-color:       @bg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

element-icon {
    background-color: transparent;
    size:             1em;
    vertical-align:   0.5;
}

message {
    background-color: @surface;
    padding:          10px;
}

textbox {
    background-color: @surface;
    text-color:       @text;
}
