{{- $palette := index .themes .theme -}}
# Appearance.
#
# Colours come from .chezmoidata/themes.toml, from whichever theme is selected.
# Edit them there, not here.

set $bg          {{ $palette.bg }}
set $surface     {{ $palette.surface }}
set $text        {{ $palette.text }}
set $text_dim    {{ $palette.text_dim }}
set $accent      {{ $palette.accent }}
set $urgent      {{ $palette.urgent }}

# `output bg` is the right place to configure this, but sway does not render
# backgrounds itself: it hands the job to swaybg, which is why swaybg is a
# declared package rather than an accident. Arch lists it as an optional
# dependency of sway described as the wallpaper tool.
#
# An absolute path rendered by chezmoi rather than a bare ~, because the path is
# passed through to swaybg and tilde expansion is not something to rely on here.
#
# `fill` scales and crops to cover the output, so the image works on any
# resolution without letterboxing. The image is a smooth gradient, so cropping
# loses nothing.
#
# The wallpaper belongs to the theme rather than being chosen separately: the
# bar and the borders are tuned to sit against it, and a palette swap that left
# the old image behind would clash. `swaymsg reload` restarts swaybg, so this is
# also the reason a theme switch needs nothing extra to change the background.
#
# The path is DERIVED, not declared. ~/.local/bin/wallpaper generates the image
# from the theme's own colours in whichever style is selected, and names it after
# the pair - so this line has to agree with that script about the naming, and
# nothing else does. A style may also be an absolute path, when a file of your
# own has been chosen, in which case it is used as it stands.
#
# The image may not exist yet when this is written. It is generated by
# run_onchange_after_reload-theme.sh, which runs after the files are applied and
# before sway is told to reload, so swaybg never looks for a file that is not
# there.
{{- $style := dig "wallpaper" .theme "mesh" . }}
{{- $bg := printf "%s/.local/share/wallpapers/%s-%s.png" .chezmoi.homeDir .theme $style }}
{{- if hasPrefix "/" $style }}{{ $bg = $style }}{{ end }}
output * bg {{ $bg }} fill

# Thin borders instead of title bars: the window list belongs in the bar, not
# repeated above every window. See the Sway section of DECISIONS.md.
#
# 3px rather than 2. The border is not only decoration - it is the target you
# have to hit to resize a window with the mouse, and sway has no separate
# setting for that: tiling_drag_threshold is about dragging by a titlebar and
# is inert when floating_mod is set, which it is here. At 2px the edge was
# nearly unhittable. Widening it is the only lever available, and 3px is
# still thin enough to read as a line rather than a frame.
#
# Worth knowing the alternative that needs no aiming at all: $mod + right-drag
# resizes from anywhere inside a window, tiled or floating.
default_border pixel 3
default_floating_border pixel 3

# Small gaps so adjacent windows read as separate objects rather than one
# surface split by a line. Enough to see, not enough to waste.
gaps inner 12

font pango:JetBrainsMono Nerd Font 10

# border | background | text | indicator | child_border
#
# Only the last two do anything, and it is worth knowing which.
#
# child_border is the frame drawn round the window, and indicator marks the
# edge where the next window will open. border is the frame around a *title
# bar*, background is that title bar's fill and text is its label - and
# nothing here has a title bar, so those three are inert. Verified by setting
# each field to a different colour and looking: the frame came out in the
# child_border colour and the rest appeared nowhere.
#
# They are left in place rather than removed because they wake up the moment
# any window is given `border normal`, which was tried and reverted - title
# bars on floating windows looked heavier than the rest of the desktop.
#
# Only the focused window gets the accent. Everything else is the same quiet
# surface colour, so where the focus is can be seen without reading anything.
client.focused          $accent  $bg  $text      $accent  $accent
client.focused_inactive $surface $bg  $text_dim  $surface $surface
client.unfocused        $surface $bg  $text_dim  $surface $surface
client.urgent           $urgent  $bg  $text      $urgent  $urgent
