[Unit]
Description=Greet empty workspaces with a system summary
Documentation=https://github.com/fastfetch-cli/fastfetch
PartOf=wayland-session@sway.target
After=wayland-session@sway.target
Requisite=wayland-session@sway.target

[Service]
Type=simple
# Watches sway for an empty workspace being focused and opens a floating
# greeting terminal on it. It greets the workspace the session starts on too,
# so this covers login as well - one mechanism rather than a separate one-shot
# unit that would race this one to open the first window.
ExecStart=%h/.local/bin/sway-workspace-greeter

# Restart=always here, unlike the one-shot this replaces: it is a daemon on the
# IPC socket now, with no legitimate reason to exit, so the same reasoning
# applies as to mako and swayidle.
Restart=always
RestartSec=1

[Install]
WantedBy=wayland-session@sway.target
