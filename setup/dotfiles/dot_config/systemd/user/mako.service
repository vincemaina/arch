[Unit]
Description=Notification daemon for the Wayland session
Documentation=man:mako(1)
PartOf=wayland-session@sway.target
After=wayland-session@sway.target
Requisite=wayland-session@sway.target

[Service]
Type=simple
ExecStart=/usr/bin/mako
ExecReload=/usr/bin/makoctl reload
Restart=always
RestartSec=1

[Install]
WantedBy=wayland-session@sway.target
