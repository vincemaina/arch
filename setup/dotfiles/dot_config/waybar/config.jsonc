// Waybar.
//
// Each module is a coloured pill. Colour identifies which readout you are
// looking at, so the bar can be scanned by colour rather than read left to
// right; state is signalled by a module changing to a warning or urgent colour.
//
// Removed: temperature, almost never acted on, and the scratchpad indicator.
// The backlight stays out until the setup runs on a machine that has one.
//
// Also removed a large amount of configuration for modules that were never
// displayed at all - mpd, a media widget, a power menu, keyboard state, a
// second battery, power profiles - which made the file look far busier than
// the bar ever was.
{
    "layer": "top",
    "position": "top",
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["idle_inhibitor", "cpu", "memory", "pulseaudio", "battery", "clock", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "{}"
    },

    "sway/window": {
        "max-length": 60,
        "tooltip": false
    },

    // Click to stop the screen locking or sleeping - for watching something,
    // or during a long build that should not be interrupted.
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip-format-activated": "Idle inhibited: the screen will not lock",
        "tooltip-format-deactivated": "Idle and locking as normal"
    },

    "cpu": {
        "format": "cpu {usage}%",
        "interval": 3,
        "tooltip": false
    },

    "memory": {
        "format": "mem {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G of {total:0.1f}G"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "tray": {
        "spacing": 10
    }
}
