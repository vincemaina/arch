// Waybar.
//
// Trimmed to what is worth a permanent place on screen. Removed: temperature,
// which is almost never acted on; the idle inhibitor and scratchpad
// indicators, which report state that is already obvious; and the backlight,
// which shows nothing on a machine without one.
//
// cpu and memory are kept at the user's request. They are the two readouts
// worth a glance on a machine tuned around not running out of memory.
//
// Also removed a large amount of configuration for modules that were never
// displayed at all - mpd, a media widget, a power menu, keyboard state, a
// second battery, power profiles - which made the file look far busier than
// the bar ever was.
{
    "layer": "top",
    "position": "top",
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["cpu", "memory", "pulseaudio", "battery", "clock", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "{}"
    },

    "sway/window": {
        "max-length": 60,
        "tooltip": false
    },

    "cpu": {
        "format": "cpu {usage}%",
        "interval": 3,
        "tooltip": false
    },

    "memory": {
        "format": "mem {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G of {total:0.1f}G"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "tray": {
        "spacing": 10
    }
}
