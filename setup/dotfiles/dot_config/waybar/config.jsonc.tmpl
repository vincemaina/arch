// Waybar.
//
// Each module is a coloured pill. Colour identifies which readout you are
// looking at, so the bar can be scanned by colour rather than read left to
// right; state is signalled by a module changing to a warning or urgent colour.
//
// The paths to the helper scripts are absolute and rendered by chezmoi, and
// that is load-bearing rather than tidiness. waybar runs as a systemd user
// service whose PATH is /usr/bin and friends - ~/.local/bin is added by .zshrc,
// which applies to interactive shells and to nothing else. A bare
// `"on-click": "calendar"` therefore works when tested in a terminal and does
// nothing at all from the bar, silently, because waybar reports nothing when a
// click command cannot be found. The desktop entries learned this first.
//
// EVERY MODULE DOES SOMETHING WHEN CLICKED. A readout you can only look at
// trains you to ignore it; a readout that opens the thing explaining it is
// worth glancing at. What each one does:
//
//   workspaces    switch to it
//   notifications open the notification centre (dismiss / restore / DND)
//   focus-timer   the timer menu: stop it, or skip to the next phase
//   clock         a calendar, three months, toggled
//   mpris         play/pause; middle goes back, right skips forward
//   idle_inhibitor  stop the screen locking, or let it again
//   network       nmtui, to change connection
//   bluetooth     the bluetooth menu: connect, pair, or turn it off
//   cpu, memory   btop
//   pulseaudio    pavucontrol; right-click mutes; scroll changes the volume
//   battery       swap between the charge and the time left on it
//
// Everything that opens a window goes through sway-toggle-window, so clicking
// twice closes it rather than leaving a second one behind.
//
// Removed: the focused window's title, which used to occupy the centre. Sway
// already says which window is focused by giving it the accent border, and the
// title was usually a truncated path. The date and time are worth that space,
// and what is playing is worth the rest of it.
//
// Also removed: temperature, almost never acted on, and the scratchpad indicator.
// The backlight stays out until the setup runs on a machine that has one.
//
// Also removed a large amount of configuration for modules that were never
// displayed at all - mpd, a media widget, a power menu, keyboard state, a
// second battery, power profiles - which made the file look far busier than
// the bar ever was.
{
    "layer": "top",
    "position": "top",
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad", "custom/notifications", "custom/focus-timer"],
    "modules-center": ["clock", "mpris"],
    // bluetooth sits next to network because they are the two radios, and it is
    // the only module here that is usually absent entirely - see its own block
    // at the end of this file for why that is the point rather than a quirk.
    "modules-right": ["idle_inhibitor", "network", "bluetooth", "cpu", "memory", "pulseaudio", "battery"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "{}"
    },
    // What is in the scratchpad, which is the one thing about it you cannot
    // otherwise see. A window put there is hidden by definition, so "how many
    // have I stashed" has no answer anywhere else on screen.
    //
    // It was removed once, in d1c9c08, on the reasoning that it "reports state
    // that is already obvious". That was right about the idle inhibitor, which
    // was cut in the same breath and does show its own state, and wrong about
    // this one for exactly the reason above. Restored rather than re-argued.
    //
    // show-empty defaults to false, so this is invisible until something is in
    // there - which is most of the time, and is why it can afford the warning
    // colour when it does appear.
    //
    // The icon is a \u escape, not a pasted glyph. U+F2D2 is window-restore,
    // checked against the font's charset rather than assumed present: a missing
    // glyph renders as an empty box, which looks configured and says nothing.
    "sway/scratchpad": {
        "format": "\uf2d2 {count}",
        "tooltip-format": "{app}: {title}",
        "on-click": "swaymsg scratchpad show"
    },

    // The notification bell. TASK-78: an easy place to see how many
    // undismissed notifications you have, in case you missed the popup - and
    // clicking it opens the notification history that already exists at
    // notification-centre (rofi, dismiss/restore/DND), rather than building a
    // second tool.
    //
    // "Undismissed" turned out not to mean `makoctl list` (what mako is
    // currently showing). mako's default-timeout is 5 seconds, so by the time
    // anyone looks at the bar a normal notification has almost always already
    // expired out of `list` and into `history` - a badge driven by `list`
    // alone would read 0 for exactly the case this exists to catch. So
    // notification-count instead tracks unseen notifications: everything in
    // `list` or `history` newer than the last time the bell was opened. See
    // that script for the detail - it is the one place the logic lives.
    //
    // Hidden entirely at zero, the same idiom sway/scratchpad uses just above:
    // invisible until there is something to say, which is what lets it afford
    // the loud colour below when it does appear.
    //
    // interval 5 matches mako's own default-timeout - no point polling faster
    // than notifications can actually change state - and the exec itself is
    // two local makoctl IPC calls plus grep/awk, no python3 startup, so this
    // is cheap even on that schedule.
    //
    // on-click is a second new script, not notification-centre directly:
    // opening the centre needs to also advance the seen-marker, and that step
    // belongs next to the script that owns the marker rather than folded into
    // an on-click one-liner.
    "custom/notifications": {
        "exec": "{{ .chezmoi.homeDir }}/.local/bin/notification-count",
        "return-type": "json",
        "interval": 5,
        "on-click": "{{ .chezmoi.homeDir }}/.local/bin/notification-bell-open"
    },

    // The focus timer's countdown.
    //
    // restart-interval, NOT interval, and that is the whole design. interval
    // would re-run the script every second - 86,400 processes a day to print a
    // clock. This script loops internally and prints a line a second, so it is
    // one process for the session; restart-interval only says how long to wait
    // before starting it again if it exits.
    //
    // It is also what advances the timer: it is already awake at the second a
    // work period ends, so a separate timer daemon would be a second
    // always-running process doing what this one cannot avoid doing anyway.
    // With waybar stopped the timer does not advance, which is the right
    // failure - a countdown nobody can see should not be pausing music.
    //
    // Prints empty text when idle, so waybar hides it and the bar does not
    // carry a dead clock - the same idiom as the scratchpad indicator.
    "custom/focus-timer": {
        "exec": "{{ .chezmoi.homeDir }}/.local/bin/focus-timer-bar",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "{{ .chezmoi.homeDir }}/.local/bin/focus-timer"
    },

    // Caffeine: keep the screen awake. Click to stop it locking or sleeping -
    // for watching something, or during a long build.
    //
    // The module type has to be idle_inhibitor because that is what waybar
    // calls it, but everything a person sees says caffeinated. The name is the
    // useful metaphor: this is not "inhibiting an idle timer", it is "do not
    // let the machine nod off".
    //
    // One glyph for both states, by codepoint - U+F0F4, a coffee cup, checked
    // against the font's charset rather than pasted. Colour carries the state
    // the way it does everywhere else on this bar: muted when off, warning
    // when on, since a machine deliberately kept awake is exactly "attention,
    // nothing wrong yet".
    "idle_inhibitor": {
        "format": "\uf0f4",
        "tooltip-format-activated": "Caffeinated: the screen will not lock or sleep",
        "tooltip-format-deactivated": "Not caffeinated: locking and sleeping as normal"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 3,
        "tooltip": false,
        "on-click": "{{ .chezmoi.homeDir }}/.local/bin/sway-toggle-window monitor foot --app-id=monitor --title=btop -e btop"
    },

    // The same window as cpu, and deliberately the same app_id: btop
    // shows both, so clicking either reading should raise the one
    // window rather than a second copy of the same program.
    "memory": {
        "format": " {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G of {total:0.1f}G",
        "on-click": "{{ .chezmoi.homeDir }}/.local/bin/sway-toggle-window monitor foot --app-id=monitor --title=btop -e btop"
    },

    // -l 1.0 on the scroll for the same reason as the media keys: wpctl
    // caps at the limit given, and without one the volume climbs past
    // 100% into distortion with nothing to say so. See TASK-41.
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "tooltip": false,
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-"
    },

    // The one module whose click opens nothing. There is no battery
    // application worth installing, and the useful second fact - how
    // long the charge has left - is a number waybar already holds.
    // format-alt swaps to it on click and back, which is the whole
    // interaction.
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false,
        "format-alt": "{icon} {time}"
    },

    // The centre of the bar, and the reason the window title is not.
    //
    // Date and time together rather than one behind a click: the point
    // of moving it here was that both are wanted at a glance. Three
    // spaces between them rather than a separator glyph, so the halves
    // read as one thing without a divider to look at.
    //
    // The format-alt that used to swap in the date is gone with it, and
    // on-click is spent on the calendar instead - waybar uses the same
    // click for both, so they cannot coexist.
    "clock": {
        "format": "{:%a %d %b   %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click": "{{ .chezmoi.homeDir }}/.local/bin/calendar"
    },

    // What is playing, when something is. The module draws nothing at
    // all while no player is running, so the centre is the clock alone
    // the rest of the time and the bar does not reserve space for it.
    //
    // waybar here links libplayerctl, so this is the built-in module
    // rather than a custom script polling playerctl on an interval.
    //
    // Icons by codepoint, never pasted. Pasting has silently lost them
    // in this repository before, leaving an empty string that looks
    // configured in the file and renders as nothing.
    //
    // No click bindings here on purpose. waybar-mpris(5) already binds left to
    // play-pause, middle to previous and right to next, and its own bindings
    // act on the player the module is following - overriding them with
    // playerctl would send the same commands by a longer route, and shipping a
    // line that changes nothing is how a config stops being readable.
    //
    // on-scroll is not overridden either: the manual documents no scroll
    // handling for this module, and configuring something undocumented is
    // indistinguishable from configuring nothing.
    //
    // The lengths, and what each one actually does - the difference
    // matters because getting it wrong makes the module disappear
    // rather than overflow. dynamic-len is a budget for the whole
    // {dynamic} string and it does not truncate anything: a tag that
    // will not fit is dropped whole. dynamic-len 45 on its own was
    // therefore not a cap on the title at all - a 60-character title
    // vanished and the bar showed the artist alone, and a long title
    // with a long artist showed nothing but the icon. Measured, not
    // assumed; see TASK-79.
    //
    // title-len and artist-len are the ones that truncate, with an
    // ellipsis. The title is capped at 30 so it always fits the budget
    // and is always the tag that survives; the artist is capped at 20
    // and is what the budget drops when a long title leaves no room
    // for it. The centre stops growing at 45 characters, and the thing
    // it gives up is never the title.
    //
    // The untruncated names stay in the tooltip: length limits do not
    // apply there unless enable-tooltip-len-limits is set, and it is
    // not, so hovering is where the full track name lives.
    //
    // Not scrolled. The module has no marquee, so scrolling the title
    // would mean replacing it with a custom module polling playerctl
    // on a timer - a permanently animating readout in the centre of
    // the bar, redrawing for text the tooltip already holds whole.
    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon}  {dynamic}",
        "dynamic-order": ["title", "artist"],
        "title-len": 30,
        "artist-len": 20,
        "dynamic-len": 45,
        "player-icons": { "default": "\uf001", "mpv": "\uf03d" },
        "status-icons": { "paused": "\uf04c" },
        "tooltip-format": "{player}\n{title}\n{artist}"
    },

    // Icons are Font Awesome codepoints, matching the set every other module
    // here uses - a themed GTK tray icon cannot, which is why the tray was
    // replaced rather than restyled. Written as \u escapes rather than pasted:
    // pasting Nerd Font glyphs has silently lost them in this repository before.
    "network": {
        "format-ethernet": "\uf0e8",
        "format-wifi": "\uf1eb {signalStrength}%",
        "format-disconnected": "\uf127",
        "tooltip-format": "{ifname} · {ipaddr}",
        "interval": 5,
        "on-click": "{{ .chezmoi.homeDir }}/.local/bin/sway-toggle-window network-tui foot --app-id=network-tui --title=nmtui -e nmtui"
    },

    // Bluetooth - TASK-146.
    //
    // THE EMPTY format-no-controller IS THE FEATURE. It is the one line in this
    // file whose purpose is to make a module disappear, so it is worth saying
    // why rather than leaving it to look like an oversight.
    //
    // bluetoothd is opted into per machine and is off by default - see
    // ~/.local/bin/bluetooth. While it is stopped there is no controller on the
    // bus, and a module that rendered "bluetooth: off" in that state would be a
    // permanent readout on every machine, including the ones with no radio at
    // all, saying nothing. Empty text hides the module outright: waybar hides a
    // module whose label is empty, the same idiom sway/scratchpad and
    // custom/notifications use above.
    //
    // So the bar's rule is: if you can see this, a daemon is running. That
    // inverts the usual relationship between a bar and a service - you are not
    // looking to find out whether bluetooth is on, you are being told that it
    // is, on the machine where you had forgotten. Verified by screenshot in
    // both directions, because "a module that is not there" and "a module that
    // is broken" look identical.
    //
    // Icons are Font Awesome \u escapes, matching every other module here, and
    // both codepoints were checked against the font's charset rather than
    // assumed: U+F293 and U+F294 fall inside JetBrains Mono Nerd Font's
    // f000-f385 range. Never pasted - pasting has silently lost glyphs here.
    //
    // No format-connected-battery. waybar can show a connected device's battery
    // level, but only through bluez's experimental interface, which needs
    // Experimental=true in /etc/bluetooth/main.conf. Configuring the format
    // without that would be a line that looks meaningful and never renders,
    // which is the exact failure this repository keeps finding.
    "bluetooth": {
        "format-no-controller": "",
        "format-disabled": "\uf294",
        "format-off": "\uf294",
        "format-on": "\uf293",
        "format-connected": "\uf293 {device_alias}",
        "tooltip-format": "{controller_alias}\nbluetoothd is running",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected:\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "{{ .chezmoi.homeDir }}/.local/bin/bluetooth"
    }
}
