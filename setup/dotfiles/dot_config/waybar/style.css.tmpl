{{- $palette := index .themes .theme -}}
{{- /* Does this theme glow? The palette carries the default and the machine may
       disagree with it - ~/.local/bin/glow writes [data.glow] in chezmoi's own
       config, which is merged over .chezmoidata, so a machine with no config
       file at all (the installer's chroot) still renders. `dig` is what makes
       the missing-key case the theme's own answer rather than an error. */ -}}
{{- $glow := eq (dig "glow" .theme $palette.glow .) "on" -}}
/* Waybar. Colours from the selected theme in .chezmoidata/themes.toml — edit
 * them there, not here.
 *
 * Every module is a coloured pill. An earlier version of this file made
 * everything uniform grey on the principle that colour should be reserved for
 * things needing attention. That reads as austere rather than minimal, and it
 * lost the thing colour is actually good for here: telling readouts apart at a
 * glance, so the bar is scanned rather than read.
 *
 * So colour identifies the module, and state escalates it — a module turns
 * warning or urgent when it needs you, which stands out precisely because the
 * resting colours are stable and familiar. */

@define-color bg          {{ $palette.bg }};
@define-color bar         {{ $palette.bar }};
@define-color surface     {{ $palette.surface }};
@define-color surface_alt {{ $palette.surface_alt }};
@define-color muted       {{ $palette.muted }};
@define-color text        {{ $palette.text }};
@define-color accent      {{ $palette.accent }};
@define-color secondary   {{ $palette.secondary }};
@define-color tertiary    {{ $palette.tertiary }};
@define-color ok          {{ $palette.ok }};
@define-color warning     {{ $palette.warning }};
@define-color urgent      {{ $palette.urgent }};
@define-color info        {{ $palette.info }};
@define-color text_dim    {{ $palette.text_dim }};

* {
    font-family: "{{ .font.family }}", monospace;
    font-size: {{ .font.bar }}px;
    min-height: 0;
}

/* The window surface is transparent and the visible bar is its child box.
 *
 * That indirection is what buys the shadow. GTK clips a box-shadow at the
 * surface edge, and waybar's surface is exactly as tall as the bar - so a
 * shadow on `window#waybar` has nowhere to fall and simply does not appear,
 * which was tried first and measured as having no effect. Painting the bar on
 * the inner box and giving that box a bottom margin makes the surface taller
 * than the bar, and the shadow lands in the gap.
 *
 * Measured rather than eyeballed, by sampling brightness down a column of a
 * screenshot: about 12 across the bar, dropping to 6 and rising back through
 * the rows beneath it, then 15 for the wallpaper. The band is darker than the
 * bar and the wallpaper both, which is what separates them. */

window#waybar {
    background: transparent;
    color: @text;
}

window#waybar > box {
    /* Fully opaque. The bar is chrome and should sit in front of the desktop
     * rather than partly in it; the colour it needs comes from the gradient
     * rather than from whatever happens to be behind it.
     *
     * The gradient takes the same path as the border below it - violet at the
     * edges through magenta at the centre - so the two read as one thing, and
     * the edges sit with the wallpaper rather than against it. mix() blends the accents into black rather than naming new
     * colours, which keeps them derived from the palette: change accent or
     * secondary and the bar follows, with no third colour to keep in step.
     *
     * The proportions are what make it a tint rather than a paint job. 10% and
     * 22% of a saturated colour into black is enough to see and not enough to
     * compete with the modules sitting on top of it. */
    background: linear-gradient(90deg,
        mix(@bar, @tertiary, 0.10) 0%,
        mix(@bar, @secondary, 0.22) 50%,
        mix(@bar, @tertiary, 0.10) 100%);

    /* A gradient hairline instead of a shadow.
     *
     * The shadow it replaces needed the surface to be taller than the bar so
     * it had somewhere to fall - GTK clips a box-shadow at the surface edge -
     * which meant carrying a bottom margin purely as scaffolding. A border is
     * drawn inside the surface, so that goes away and the bar ends exactly
     * where it ends.
     *
     * border-image paints the gradient; border-bottom gives it somewhere to be
     * painted. The width has to be declared separately and only on the bottom,
     * or the gradient wraps all four sides.
     *
     * The colours run tertiary to secondary and back, so the line is brightest
     * where the bloom behind it is strongest, and the two read as one thing
     * rather than two decorations that happen to share an edge. */
    /* The glow. An inset shadow in the emphasis colour, thrown upward from the
     * bottom edge, so the bar looks lit from the strip beneath it rather than
     * merely bordered by it.
     *
     * Inset deliberately: an outer glow would need the surface to be taller
     * than the bar to have anywhere to fall - the same constraint that made
     * the drop shadow need a margin - whereas an inset one is painted inside
     * the bar and needs nothing. It is static, so it costs nothing per frame.
     *
     * Kept tight. A wider blur on a 28px bar reaches the top edge and stops
     * looking like light coming from the strip below.
     *
     * Present only when the theme glows. With the glow off the hairline below
     * is left to do the job on its own, which is what it was drawn for - the
     * bloom is the decoration, not the separator. */
{{- if $glow }}
    box-shadow: inset 0 -3px 5px -4px mix(@bar, @secondary, 0.55);
{{- end }}

    border-bottom: 1px solid transparent;
    border-image: linear-gradient(90deg,
        @tertiary 0%,
        @secondary 50%,
        @tertiary 100%) 1;

    /* Breathing room at the ends. Padding on the box rather than margins on
     * the outermost modules: padding sits inside the background and the
     * border, so the gradient and the hairline still run the full width of the
     * screen while nothing inside them sits flush against the edge. Doing it
     * with module margins instead would mean remembering to move it every time
     * the first or last module changes. */
    padding: 0 10px;
}

/* The shared pill shape. Dark text on a saturated background reads better at
 * this size than the reverse, and keeps every module the same visual weight.
 *
 * The radius is fully rounded rather than softened corners, and each pill
 * carries a shadow beneath it. Together those lift the modules off the bar
 * instead of leaving them flush with it - the bar reads as a surface with
 * things sitting on it rather than as a strip of coloured blocks.
 *
 * Worth knowing this is possible at all: waybar is GTK3, so its stylesheet
 * gets shadows, gradients and rounded corners - none of which sway itself can
 * draw. A client can decorate its own surface however it likes; the compositor
 * drawing borders around windows cannot. */
#idle_inhibitor,
#cpu,
#memory,
#pulseaudio,
#battery,
#clock,
#mpris,
#scratchpad,
#custom-notifications,
#custom-focus-timer,
#bluetooth,
#network {
    background: transparent;
    /* Enough to keep the hover pill off its own text, and no more. The gap
     * between readings is the bar's spacing plus this; wider padding made the
     * hover pill look inflated without making the resting bar any easier to
     * read. */
    padding: 0 7px;
    margin: 4px 0;
    border-radius: 14px;
}

/* The colour moves from the pill to the text. Each module keeps the hue it
 * always had; it is now the glyph and the number that carry it rather than a
 * block behind them, which is quieter and lets the bar's own gradient show
 * through between the readings. */
/* Each reading glows in its own colour. A text-shadow with no offset is how a
 * glow is spelled, and being static it costs nothing to draw - which is the
 * whole reason this is here and the animated gradient is not.
 *
 * OPTIONAL, AND KEPT CLOSE
 *
 * Every one of these is behind `$glow`, so a theme that does not want haloes
 * renders without them entirely rather than setting `none` afterwards - there
 * is no rule left to override, and nothing to go stale. `glow` toggles it and
 * remembers the answer per theme.
 *
 * The radii used to be 5, 6 and 7 pixels and are now 3, 4 and 5. At the old
 * sizes the halo reached well past the glyph and neighbouring readouts bled
 * into each other on a bar only 34 pixels tall; the point of the effect is
 * that the text looks lit, which needs the light to stay where the text is. */
#idle_inhibitor { color: @muted;    {{ if $glow }} text-shadow: 0 0 3px @muted;{{ end }} }
#cpu            { color: @info;     {{ if $glow }} text-shadow: 0 0 3px @info;{{ end }} }
#memory         { color: @secondary;{{ if $glow }} text-shadow: 0 0 3px @secondary;{{ end }} }
#pulseaudio     { color: @ok;       {{ if $glow }} text-shadow: 0 0 3px @ok;{{ end }} }
#battery        { color: @ok;       {{ if $glow }} text-shadow: 0 0 3px @ok;{{ end }} }
#network        { color: @muted;    {{ if $glow }} text-shadow: 0 0 3px @muted;{{ end }} }

/* Bluetooth, which is the one module here that says something by its mere
 * presence - see the config for why it is invisible whenever bluetoothd is not
 * running. Given that, the states worth telling apart are not on versus off;
 * they are "this daemon is earning its keep" and "this daemon is running for
 * nothing", and the palette already has a role for the second one.
 *
 * connected  secondary, the same weight as any other working readout
 * on         warning: the radio is up and nothing is using it, which is the
 *            state this whole feature exists to make visible. `warning` is the
 *            role that means attention-nothing-wrong-yet, the same reading
 *            sway/scratchpad relies on above, and it is legible in all eight
 *            themes - unlike tertiary, which falls to 2.04:1 in mono.
 * off        muted: the daemon is up but the controller is powered down, which
 * disabled   is wasteful but quieter than an idle radio, and rfkill is usually
 *            somebody's deliberate act rather than something to nag about.
 *
 * secondary rather than info because cpu two modules along is already info, and
 * the bar is meant to be scanned by colour - two neighbours in the same hue is
 * the one thing that defeats that. memory is also secondary but cpu sits
 * between them. */
#bluetooth           { color: @secondary;{{ if $glow }} text-shadow: 0 0 3px @secondary;{{ end }} }
#bluetooth.connected { color: @secondary;{{ if $glow }} text-shadow: 0 0 3px @secondary;{{ end }} }
#bluetooth.on        { color: @warning;  {{ if $glow }} text-shadow: 0 0 3px @warning;{{ end }} }
#bluetooth.off,
#bluetooth.disabled  { color: @muted;    {{ if $glow }} text-shadow: 0 0 3px @muted;{{ end }} }

/* The scratchpad, in the warning colour rather than a quiet one.
 *
 * It is hidden whenever the scratchpad is empty, which is nearly always, so it
 * is not competing for attention the rest of the time - it can afford to be
 * seen when it does appear, and being seen is the entire point of a readout
 * about windows you have hidden.
 *
 * `warning` is also the only palette role that means what this means: attention,
 * nothing wrong yet. And it is the legible choice - measured across all eight
 * themes it sits between 8.6:1 and 13.4:1 against the background, where
 * `tertiary`, the obvious pick since the workspace discs use it, falls to
 * 2.04:1 in mono. Tertiary is a fill colour with light text on top of it, not
 * a text colour. */
#scratchpad     { color: @warning;  {{ if $glow }} text-shadow: 0 0 3px @warning;{{ end }} }

/* Same reasoning as the scratchpad just above: hidden almost always, so it
 * can afford the warning colour on the rare occasions it is not - "something
 * is waiting, nothing is wrong". notification-count leaves text empty at
 * zero, and waybar hides a custom module outright when its text is empty, so
 * there is no bare bell glyph sitting in the bar the rest of the time. */
#custom-notifications { color: @warning;{{ if $glow }} text-shadow: 0 0 3px @warning;{{ end }} }

/* The focus timer, coloured by phase rather than by one fixed colour: working
 * is the accent, a break is the calmer ok green, and the moment a break is due
 * but unanswered is urgent - that state is the one worth noticing, and it is
 * the only one the timer cannot advance out of on its own. */
#custom-focus-timer.work    { color: @accent;{{ if $glow }} text-shadow: 0 0 3px @accent;{{ end }} }
#custom-focus-timer.break   { color: @ok;    {{ if $glow }} text-shadow: 0 0 3px @ok;{{ end }} }
#custom-focus-timer.pending { color: @urgent;{{ if $glow }} text-shadow: 0 0 4px @urgent;{{ end }} }

/* The centre. The clock took the space the focused window's title used to
 * have, and with it the job of being the one bright thing in the middle of the
 * bar - so it keeps the emphasis treatment rather than the quieter one it had
 * while it sat among the readouts on the right.
 *
 * What is playing sits beside it in the secondary colour, and only when
 * something is playing: the mpris module draws nothing at all when no player is
 * running, so the centre is the clock alone the rest of the time. */
#clock {
    color: @accent;
    font-weight: bold;
{{- if $glow }}
    text-shadow: 0 0 4px @accent;
{{- end }}
}

#mpris {
    color: @secondary;
{{- if $glow }}
    text-shadow: 0 0 4px @secondary;
{{- end }}
}

/* Paused is still worth showing - it is the difference between "nothing is
 * playing" and "something is waiting for you" - but it should stop asking for
 * attention, so it drops to the dim colour and loses its glow. */
#mpris.paused {
    color: @text_dim;
    text-shadow: none;
}

/* The pill comes back on hover, so the shape is still there when you reach for
 * something - it just is not there when you are only reading. Dark text on the
 * module's own colour, which is the inverse of the resting state. */
#idle_inhibitor:hover,
#cpu:hover,
#memory:hover,
#pulseaudio:hover,
#battery:hover,
#clock:hover,
#mpris:hover,
#scratchpad:hover,
#custom-notifications:hover,
#custom-focus-timer:hover,
#bluetooth:hover,
#network:hover {
    color: @bg;
    /* The glow goes on hover. Dark text on a bright pill does not want a halo
     * in the pill's own colour behind it. */
    text-shadow: none;
    /* Nearly opaque black is right over a black bar and far too heavy over a
     * white one, where it reads as a smudge under the pill rather than lift.
     * The colour stays black either way - a shadow is an absence of light, not
     * a palette colour - and only how much of it lands changes. */
    box-shadow: 0 3px 8px rgba(0, 0, 0, {{ if eq $palette.mode "light" }}0.25{{ else }}0.9{{ end }});
}

#idle_inhibitor:hover { background: @surface_alt; color: @text; }
#cpu:hover            { background: @info; }
#memory:hover         { background: @secondary; }
#pulseaudio:hover     { background: @ok; }
#battery:hover        { background: @ok; }
#clock:hover          { background: @accent; }
#scratchpad:hover     { background: @warning; }
#custom-notifications:hover { background: @warning; }
#mpris:hover          { background: @secondary; }
#network:hover        { background: @surface_alt; color: @text; }
/* The hover pill takes the resting hue, so an idle radio still reads as the
 * warning colour under the cursor rather than losing the one thing it was
 * saying. */
#bluetooth:hover      { background: @secondary; }
#bluetooth.on:hover   { background: @warning; }
#bluetooth.off:hover,
#bluetooth.disabled:hover { background: @surface_alt; color: @text; }

/* Workspaces are the exception: they are navigation, not a readout, so only
 * the one you are on is filled in. */
#workspaces {
    margin: 3px 6px;
}

/* Workspaces are marked by COLOUR, not by a filled shape.
 *
 * The focused one used to be a filled disc, and it was the loudest thing on a
 * bar whose whole design is that colour identifies and shape does not. It also
 * fought the caffeine indicator, which was a filled disc for the same bad
 * reason - two solid blobs competing on a strip 34 pixels tall.
 *
 * So: the active workspace is bright, the others are muted, and nothing is
 * filled unless you are pointing at it. The glow is emphasis on top of that
 * rather than the thing doing the work - accent against muted still reads on
 * a theme that has turned it off. The pill on hover is there
 * to show where the click lands, which is the one thing a shape is genuinely
 * better at than a colour.
 *
 * min-width and min-height stay equal so the hover target is a circle rather
 * than a lozenge that changes size with the label. */
#workspaces button {
    color: @muted;
    background: transparent;
    font-weight: bold;
    padding: 0;
    margin: 0 3px;
    min-width: 22px;
    min-height: 22px;
    border: none;
    border-radius: 50%;
}

#workspaces button.focused {
    color: @accent;
{{- if $glow }}
    text-shadow: 0 0 4px @accent;
{{- end }}
    background: transparent;
}

/* Urgent still fills, and that is the point: it is the one state that should
 * interrupt rather than inform, so it gets the shape nothing else uses. */
#workspaces button.urgent {
    color: @bg;
    background: @urgent;
}

#workspaces button:hover {
    color: @text;
    background: @surface_alt;
    text-shadow: none;
}

/* A mode is temporary and modal, so it says so loudly. */
#mode {
    color: @bg;
    background: @warning;
    padding: 0 10px;
    margin: 4px 3px;
    border-radius: 6px;
}

/* State escalation. These override the resting colour above. */

/* Caffeine lights up rather than filling.
 *
 * It was a warning-coloured disc, and on a 34px bar a filled circle behind a
 * cup glyph clipped the saucer and read as a blob. The bar already says
 * everything else with colour; there is no reason this one thing should shout
 * with a shape.
 *
 * Bright against muted is a large enough difference to read at a glance, and
 * it is the same language the workspaces now use. The glow sharpens it where
 * a theme wants one, and is not what carries it. */
#idle_inhibitor.activated {
    background: transparent;
    color: @warning;
{{- if $glow }}
    text-shadow: 0 0 5px @warning;
{{- end }}
}

#pulseaudio.muted {
    background: @surface_alt;
    color: @muted;
}

#battery.warning:not(.charging) {
    background: @warning;
}

#battery.critical:not(.charging) {
    background: @urgent;
}
