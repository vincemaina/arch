# yazi keybindings.
#
# Additions only. prepend_keymap is merged in front of yazi's defaults rather
# than replacing them, so everything the manual documents still works.

[mgr]
prepend_keymap = [
    # A terminal where you are looking, and then get out of the way.
    #
    # `o` for the thing under the cursor and Ctrl+o for the directory you are
    # in. `o` is unbound in yazi's defaults - checked by extracting all 73 of
    # them from the binary rather than by remembering - so neither shadows
    # anything.
    #
    # Both close yazi afterwards, and the helper does that itself with
    # `ya emit quit`. Chaining `quit` into the array here does quit, but it
    # races the shell command and the shell never runs at all - so the order
    # has to be enforced from inside the helper, after the terminal is up.
    #
    # $0 is the hovered entry. Absolute path to the helper for the same reason
    # the opener uses one: yazi's PATH comes from sway, which does not have
    # ~/.local/bin on it.
    { on = "o", run = "shell '{{ .chezmoi.homeDir }}/.local/bin/yazi-terminal \"$0\"' --orphan", desc = "Terminal at cursor" },
    { on = "<C-o>", run = "shell '{{ .chezmoi.homeDir }}/.local/bin/yazi-terminal' --orphan", desc = "Terminal here" },
]
