# yazi, the file manager on $mod+e.
#
# WHY `edit` IS A SCRIPT AND NOT `nvim`
#
# yazi's default rule for a directory is
#
#     { url = "*/", use = [ "edit", "open", "reveal" ] }
#
# with `edit` first, so Enter on a folder runs whatever `edit` is. That was
# harmless while `edit` was yazi's default ${EDITOR:-vi} and EDITOR was unset,
# because it failed - and the moment it was pointed at a working nvim, Enter on
# a folder started opening the folder in the editor.
#
# ~/.local/bin/yazi-open is the fix: a directory asks yazi to navigate into it,
# and anything else opens in nvim. Both halves of Enter behave the way they
# should, and no [open] rule has to be overridden - an override was tried and
# taken back out, because a rule matching "*/" turned out to catch files too.
#
# The path is absolute because it must be. yazi inherits its PATH from whatever
# started it, which is sway, and ~/.local/bin is not on the session PATH - the
# same trap that made the bar's click commands and the desktop entries silently
# do nothing.
#
# WHY `%s` AND NOT `"$@"`
#
# This said `"$@"` until yazi 26.8, and it worked because yazi used to run an
# opener as `sh -c '<run>' <files...>` - the files really were shell positional
# arguments. It does not any more. `run` is now a template yazi substitutes
# itself before handing one finished string to `sh -c`, with no arguments at
# all. Measured on 26.8.15, all three of `$@`, `$0` and `$1` come through empty:
#
#     %s    every selected file, each already quoted
#     %s1   just the first one          %d1   the directory containing it
#
# So `"$@"` became the shell's own empty argument list and the opener ran
# `yazi-open` with nothing - `set -u` on `$1`, and that error in a blocking
# opener is the whole of "Enter no longer opens the file" (TASK-172). Nothing
# warned, because the old syntax is still perfectly valid shell; it just expands
# to nothing now.
#
# Do not quote `%s`. yazi quotes each path as it substitutes - a filename with
# spaces was checked and arrives as one argument - and a `"%s"` would collapse a
# multi-file selection into a single argument.

[opener]
edit = [
    { run = '{{ .chezmoi.homeDir }}/.local/bin/yazi-open %s', desc = "nvim", block = true, for = "unix" },
]
