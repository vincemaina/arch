#!/usr/bin/env bash
set -euo pipefail

# requires: qutebrowser swaymsg python3

# Open the browser, or bring the one that is already open to where you are.
#
# WHY THIS EXISTS, WITH THE NUMBERS THAT JUSTIFY IT
#
# Measured on this machine, from keypress to a usable window:
#
#   cold start, no process running     942ms
#   new window, process already up     553ms
#   focusing the window already open     1ms
#
# $mod+b ran qutebrowser directly, so every press paid one of the first two.
# qutebrowser does reuse its process over its IPC socket - a second invocation
# does not re-import Python or re-initialise QtWebEngine - but it still MAPS A
# NEW WINDOW, and that is where the remaining half second goes.
#
# So the fix is not to make the browser start faster. It is to stop starting it.
# If a window exists, this moves it to the current workspace and focuses it.
#
# WHY NOT PRE-WARM IT AT LOGIN
#
# Starting qutebrowser at login would make the first press fast too, and it was
# rejected: QtWebEngine is the largest resident thing on the machine, and paying
# for it from login on a box with 3.9 GiB - to save 400ms once a day - is the
# wrong trade. TASK-66 found the desktop idles around 350 MiB precisely because
# nothing is running that nobody asked for.
#
# WHY NOT sway-toggle-window
#
# That helper opens or CLOSES, which is right for a calendar you glance at and
# wrong here: closing qutebrowser's last window exits the process, so the next
# press would pay the full 942ms again. This only ever brings the window to you.

APP_ID="org.qutebrowser.qutebrowser"

# The most recently focused matching window, if any. Ordering matters with more
# than one open: the one you last used is the one you mean.
existing="$(swaymsg -t get_tree 2>/dev/null | python3 -c '
import json, sys

app_id = sys.argv[1]
best = None

def walk(node):
    global best
    if node.get("app_id") == app_id:
        # focus is a monotonically increasing id in sway; higher is more recent.
        order = node.get("focus_order", 0) or 0
        stamp = max([order] + node.get("focus", []) or [0])
        if best is None or stamp >= best[0]:
            best = (stamp, node["id"])
    for key in ("nodes", "floating_nodes"):
        for child in node.get(key, []):
            walk(child)

try:
    walk(json.load(sys.stdin))
except Exception:
    sys.exit(0)

if best:
    print(best[1])
' "$APP_ID" 2>/dev/null || true)"

if [[ -n "$existing" ]]; then
    # `move container to workspace current` brings it here rather than sending
    # you to it: the browser should arrive where you are working, not move you
    # somewhere else mid-thought.
    exec swaymsg "[con_id=$existing] move container to workspace current, focus" >/dev/null
fi

exec qutebrowser "$@"
