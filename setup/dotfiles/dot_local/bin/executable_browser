#!/usr/bin/env bash
set -euo pipefail

# requires: firefox qutebrowser vimb

# Launch the browser this machine is currently set to.
#
#   browser                 open a window in the selected browser
#   browser <url> [...]     the same, with arguments passed through
#   browser --current       which one is selected
#   browser --list          all of them, marking the selected one
#   browser --use firefox   select firefox from now on
#   browser --use vimb
#   browser --use qutebrowser
#
# WHY THIS EXISTS AT ALL, HAVING JUST BEEN DELETED
#
# TASK-174 removed this file, because by then it did nothing a bare
# `qutebrowser` did not. It is back for a different reason, and the difference
# matters: it no longer decides HOW to open a browser, only WHICH one.
#
# TASK-177 measured the field. Cold start, keypress to a mapped window, on the
# balanced power profile:
#
#     foot           135 ms     the target - a terminal
#     vimb           354 ms     webkit2gtk
#     netsurf        432 ms     its own engine
#     epiphany       843 ms     webkitgtk
#     qutebrowser   1673 ms     qt6-webengine
#
# vimb is 193 KiB of browser on top of WebKitGTK, so its 354 ms is essentially
# the engine starting: no WebKitGTK browser can be faster, and epiphany's extra
# half second is its own GTK4 interface rather than anything to do with pages.
# qutebrowser's extra 1.3 s is QtWebEngine.
#
# WHY THE DEFAULT IS FIREFOX, WHICH IS NOT ON THAT LIST
#
# It is not on that list because in August 2026 it was not a candidate: TASK-91
# had already decided two browsers, qutebrowser for everything and firefox for
# DRM and extensions only. TASK-183 reversed that, and the reason is the thing
# the table above cannot measure.
#
# Cold start is a real cost paid once per window. Sites that do not work are a
# cost paid at an unpredictable moment, in the middle of doing something else,
# and the only remedy is to open a second browser and start again. Daily use
# found the second cost to be the larger one, and firefox to be the browser
# where it does not arise.
#
# firefox is measurably the more expensive of the two on both axes that can be
# measured - TASK-183 got 862ms to a mapped window against qutebrowser's 363ms
# warm, and 674 MiB idle against 108 MiB - and is chosen anyway, on the axis
# neither number covers. DECISIONS.md has the table and its caveats.
#
# The reason qutebrowser was chosen in the first place was keyboard-driven
# browsing, and Vimium gives firefox that - installed by enterprise policy, not
# by hand, so it is on a rebuilt machine too. See setup/system/firefox/.
#
# So this is no longer a trial switch with a default that means "the safe one".
# It is a preference, and firefox is the preference. vimb and qutebrowser stay
# reachable because they are still installed and the switch costs nothing.
#
# WHY THE STATE IS A PLAIN FILE AND NOT chezmoi.toml
#
# Theme, wallpaper style and glow are all machine-local settings and all live
# in chezmoi's own config, read through ~/.local/lib/desktop_config.py. This
# does not, deliberately, and the reason is the whole point of the exercise:
# desktop_config.py shells out to `chezmoi data`, which costs upwards of 100 ms,
# and this file is on the path between pressing $mod+b and seeing a window. A
# switch that made the fast browser start slower would be self-defeating.
#
# So it is one line in ~/.local/state, read with `cat`. That is the same
# decision, for the same reason, that DECISIONS.md records for the sound pack -
# see "Sound packs" there before changing how this is stored.

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/browser"

# Compiled in rather than read from anywhere, so a machine with no state file -
# which is every freshly installed one - opens firefox on $mod+b.
#
# Changing this line is not enough on its own. A machine that ever ran
# `browser --use` has a state file naming the old choice, and that file wins.
# `browser --current` is how you find out which is happening.
DEFAULT="firefox"

# The whitelist is here rather than inferred from what is installed, so that a
# typo in the state file is a fallback rather than an attempt to exec whatever
# the word happens to name. Keep in step with the `# requires:` line above:
# checks/sway-commands.sh reads that line to prove every command this can run
# comes from a declared package.
SUPPORTED=(firefox qutebrowser vimb)

die() { echo "browser: $*" >&2; exit 1; }

is_supported() {
    local candidate="$1" name
    for name in "${SUPPORTED[@]}"; do
        [[ "$name" == "$candidate" ]] && return 0
    done
    return 1
}

# A missing, empty or unrecognised state file selects the default rather than
# failing. This runs on a keypress, and a keybinding that silently does nothing
# is the exact failure this repository keeps finding - better to get the wrong
# browser, visibly, than no window and no message.
selected() {
    local value=""
    [[ -r "$STATE" ]] && value="$(tr -d '[:space:]' < "$STATE" 2>/dev/null || true)"
    if is_supported "$value"; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "$DEFAULT"
    fi
}

case "${1:-}" in
    --current)
        selected
        ;;
    --list)
        current="$(selected)"
        for name in "${SUPPORTED[@]}"; do
            if [[ "$name" == "$current" ]]; then
                printf '* %s\n' "$name"
            else
                printf '  %s\n' "$name"
            fi
        done
        ;;
    --use)
        [[ $# -eq 2 ]] || die "usage: browser --use <${SUPPORTED[*]}>"
        is_supported "$2" || die "'$2' is not one of: ${SUPPORTED[*]}"
        mkdir -p "$(dirname "$STATE")"
        printf '%s\n' "$2" > "$STATE"
        echo "\$mod+b now opens $2"
        ;;
    -h|--help)
        sed -n '6,14p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    --*)
        die "unknown option '$1'. Try --help"
        ;;
    *)
        # Arguments are passed through so `browser https://...` works, which is
        # what anything opening a URL through this expects.
        #
        # A LAUNCH IS A WINDOW, NOT A TAB, AND FIREFOX NEEDS TELLING
        #
        # sway/config states that invariant and 40-window-rules.conf depends on
        # it - the browser rule floats and sizes a window, and a launch that
        # only added a tab to an existing one would appear to do nothing at all.
        # qutebrowser gets there through `new_instance_open_target` in its own
        # config, and vimb is one process per invocation already. firefox is the
        # one that defaults the other way, so it is asked here.
        #
        # This is deliberately NOT in firefox.desktop, which is what opens links
        # from other applications. A link arriving from a notification or the
        # launcher belongs in a tab of the browser already open; only pressing
        # $mod+b means "give me a browser".
        target="$(selected)"
        if [[ "$target" == "firefox" ]]; then
            exec firefox --new-window "$@"
        fi
        exec "$target" "$@"
        ;;
esac
