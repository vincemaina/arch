#!/usr/bin/env bash
set -euo pipefail

# requires: qutebrowser vimb

# Launch the browser this machine is currently trialling.
#
#   browser                 open a window in the selected browser
#   browser <url> [...]     the same, with arguments passed through
#   browser --current       which one is selected
#   browser --list          both, marking the selected one
#   browser --use vimb      select vimb from now on
#   browser --use qutebrowser
#
# WHY THIS EXISTS AT ALL, HAVING JUST BEEN DELETED
#
# TASK-174 removed this file, because by then it did nothing a bare
# `qutebrowser` did not. It is back for a different reason, and the difference
# matters: it no longer decides HOW to open a browser, only WHICH one.
#
# TASK-177 measured the field. Cold start, keypress to a mapped window, on the
# balanced power profile:
#
#     foot           135 ms     the target - a terminal
#     vimb           354 ms     webkit2gtk
#     netsurf        432 ms     its own engine
#     epiphany       843 ms     webkitgtk
#     qutebrowser   1673 ms     qt6-webengine
#
# vimb is 193 KiB of browser on top of WebKitGTK, so its 354 ms is essentially
# the engine starting: no WebKitGTK browser can be faster, and epiphany's extra
# half second is its own GTK4 interface rather than anything to do with pages.
# qutebrowser's extra 1.3 s is QtWebEngine.
#
# What no benchmark settles is whether WebKitGTK renders the sites actually
# used well enough to live with - it is weaker than Blink on recent JavaScript.
# That is a question you answer by using it for a week, so this exists to make
# that week cheap, and to make abandoning it cheaper.
#
# WHY THE STATE IS A PLAIN FILE AND NOT chezmoi.toml
#
# Theme, wallpaper style and glow are all machine-local settings and all live
# in chezmoi's own config, read through ~/.local/lib/desktop_config.py. This
# does not, deliberately, and the reason is the whole point of the exercise:
# desktop_config.py shells out to `chezmoi data`, which costs upwards of 100 ms,
# and this file is on the path between pressing $mod+b and seeing a window. A
# switch that made the fast browser start slower would be self-defeating.
#
# So it is one line in ~/.local/state, read with `cat`. That is the same
# decision, for the same reason, that DECISIONS.md records for the sound pack -
# see "Sound packs" there before changing how this is stored.

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/browser"
DEFAULT="qutebrowser"

# The whitelist is here rather than inferred from what is installed, so that a
# typo in the state file is a fallback rather than an attempt to exec whatever
# the word happens to name. Keep in step with the `# requires:` line above:
# checks/sway-commands.sh reads that line to prove every command this can run
# comes from a declared package.
SUPPORTED=(qutebrowser vimb)

die() { echo "browser: $*" >&2; exit 1; }

is_supported() {
    local candidate="$1" name
    for name in "${SUPPORTED[@]}"; do
        [[ "$name" == "$candidate" ]] && return 0
    done
    return 1
}

# A missing, empty or unrecognised state file selects the default rather than
# failing. This runs on a keypress, and a keybinding that silently does nothing
# is the exact failure this repository keeps finding - better to get the wrong
# browser, visibly, than no window and no message.
selected() {
    local value=""
    [[ -r "$STATE" ]] && value="$(tr -d '[:space:]' < "$STATE" 2>/dev/null || true)"
    if is_supported "$value"; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "$DEFAULT"
    fi
}

case "${1:-}" in
    --current)
        selected
        ;;
    --list)
        current="$(selected)"
        for name in "${SUPPORTED[@]}"; do
            if [[ "$name" == "$current" ]]; then
                printf '* %s\n' "$name"
            else
                printf '  %s\n' "$name"
            fi
        done
        ;;
    --use)
        [[ $# -eq 2 ]] || die "usage: browser --use <${SUPPORTED[*]}>"
        is_supported "$2" || die "'$2' is not one of: ${SUPPORTED[*]}"
        mkdir -p "$(dirname "$STATE")"
        printf '%s\n' "$2" > "$STATE"
        echo "\$mod+b now opens $2"
        ;;
    -h|--help)
        sed -n '6,13p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    --*)
        die "unknown option '$1'. Try --help"
        ;;
    *)
        # Arguments are passed through so `browser https://...` works, which is
        # what anything opening a URL through this expects.
        exec "$(selected)" "$@"
        ;;
esac
