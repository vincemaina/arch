#!/usr/bin/env bash
set -euo pipefail

# requires: mpv playerctl rofi systemd-run yt-dlp curl

# Background music, one launcher entry away and then invisible.
#
# Picks a station from ~/.config/focus-music/stations - or searches YouTube for
# whatever you type - and hands the result to mpv, which exposes itself over
# MPRIS, so the bar's media module and the playback keys control it from then on
# and this script is not involved again.
#
# WHY IT STARTS mpv IN ITS OWN SCOPE
#
# Launched from rofi, mpv would be a child of whatever spawned it and would sit
# in that process's cgroup. The workspace greeter learned this the expensive
# way: systemd's default KillMode is control-group, so restarting the service
# that happened to spawn something kills it, and a sway crash SIGKILLs anything
# in the compositor's own cgroup ten seconds later. Music that stops when the
# launcher closes, or when an unrelated unit restarts, is not worth having.
#
# systemd-run --scope puts it in a transient scope under app.slice, which is
# where a user application belongs. --collect cleans the scope up when mpv
# exits.
#
# WHAT IS KEPT IS A SEARCH, NOT A LINK
#
# A station line's second field is either a URL played directly, or the word
# search: followed by text, which is handed to YouTube and resolved to whatever
# it finds now. Everything this script writes down is the second kind, and that
# is deliberate: a video id is a link that rots, and a list of rotted links is
# discovered one silence at a time. A search cannot 404. It also survives the
# failure TASK-145 documented, where a channel restarts its 24/7 broadcast under
# a new id and every recorded id for it dies at once.
#
# Nothing is written down at all unless you ask for it. Searching and playing
# leaves no trace; "Keep this station" is the only writer, and it appends to
# stations.local, which chezmoi does not manage - so keeping something is not a
# repository diff and `chezmoi apply` cannot clobber it.
#
# --check is for the links that genuinely are links: it resolves every entry in
# both files and names the dead ones, so pruning is a decision rather than a
# discovery.

STATIONS="${XDG_CONFIG_HOME:-$HOME/.config}/focus-music/stations"
LOCAL_STATIONS="${XDG_CONFIG_HOME:-$HOME/.config}/focus-music/stations.local"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/focus-music"
STATE="$STATE_DIR/current"

# How many search results to offer. Enough to choose from, few enough to read
# without scrolling.
SEARCH_RESULTS=15

# The MPRIS name mpv registers under. Matching on it rather than on any player
# means this never stops somebody's video or a Spotify client.
MPRIS_PREFIX="mpv"

die() {
    echo "focus-music: $*" >&2
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a focus-music "focus-music" "$*" || true
    exit 1
}

note() {
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a focus-music -t 4000 "focus music" "$1" || true
}

playing_instance() {
    # playerctl exits non-zero with no players, which is not an error here.
    playerctl --list-all 2>/dev/null | grep -m1 "^${MPRIS_PREFIX}" || true
}

now_playing() {
    local inst="$1"
    playerctl --player="$inst" metadata --format '{{ title }}' 2>/dev/null || true
}

# Seconds to something a human reads at a glance. A live stream has no duration
# at all and yt-dlp prints NA for it, which is why the caller decides the badge
# and this only ever sees a recording.
fmt_duration() {
    local s="${1:-}"
    [[ "$s" =~ ^[0-9]+$ ]] || { printf '%s' '--:--'; return; }
    local h=$(( s / 3600 )) m=$(( (s % 3600) / 60 )) sec=$(( s % 60 ))
    if (( h > 0 )); then
        printf '%d:%02d:%02d' "$h" "$m" "$sec"
    else
        printf '%d:%02d' "$m" "$sec"
    fi
}

# Both station files, in order, into parallel arrays. The tracked list first so
# it stays the top of the menu, then whatever this machine has kept.
LABELS=()
TARGETS=()
read_entries() {
    LABELS=()
    TARGETS=()
    local file label target
    for file in "$STATIONS" "$LOCAL_STATIONS"; do
        [[ -r "$file" ]] || continue
        while IFS=$'\t' read -r label target; do
            [[ -n "$label" && -n "$target" ]] || continue
            LABELS+=("$label")
            TARGETS+=("$target")
        done < <(grep -P '^[^#].*\t' "$file" || true)
    done
}

# A target is either a URL or search:<text>. Resolving happens here and nowhere
# else, so adding another kind later is one case statement.
resolve_target() {
    local target="$1" query found
    case "$target" in
        search:*)
            query="${target#search:}"
            found="$(yt-dlp --flat-playlist --no-warnings --print '%(id)s' \
                        "ytsearch1:$query" 2>/dev/null | head -1 || true)"
            [[ -n "$found" ]] || return 1
            printf 'https://www.youtube.com/watch?v=%s' "$found"
            ;;
        *)
            printf '%s' "$target"
            ;;
    esac
}

# label, target, kind. kind is "station" for anything already written down and
# "search" for an ad-hoc result, which is the only thing worth offering to keep.
start_playing() {
    local label="$1" target="$2" kind="$3" url

    [[ "$target" == search:* ]] && note "Finding \"$label\"..."

    # Resolve before stopping anything, so a slow lookup does not leave silence.
    url="$(resolve_target "$target")" || die "nothing found for '$label'"

    pkill -x -u "$(id -u)" mpv 2>/dev/null || true

    mkdir -p "$STATE_DIR"
    printf '%s\t%s\t%s\n' "$kind" "$target" "$label" > "$STATE"

    # --force-media-title so the bar shows the station name rather than the
    # stream's own metadata, which for a radio stream is the current track and
    # changes under you - useful in a player, confusing as a label for "what am
    # I listening to".
    systemd-run --user --scope --quiet --collect -- \
        mpv --no-terminal --force-media-title="$label" "$url" >/dev/null 2>&1 &

    disown
}

stop_playing() {
    local inst="$1"
    playerctl --player="$inst" stop 2>/dev/null || true
    # stop leaves mpv running with nothing to play; quit it properly so the
    # bar's module empties rather than showing a paused ghost.
    pkill -x -u "$(id -u)" mpv 2>/dev/null || true
    rm -f "$STATE"
}

# Type something, get results, play one. Nothing here is written down.
do_search() {
    local query
    query="$(printf '' |
        rofi -dmenu -i -p 'search youtube' -format s \
             -theme-str 'listview { lines: 0; }' 2>/dev/null || true)"
    [[ -n "$query" ]] || exit 0

    note "Searching YouTube for \"$query\"..."

    local ids=() titles=() rows=()
    local kind id live duration title badge
    # Fields are tab separated with the title last, so a title containing a tab
    # lands in the last variable rather than shifting every column after it.
    #
    # The template is $'...' rather than '...' because yt-dlp does not expand
    # escape sequences itself: with a literal backslash-t every field arrives
    # in the first variable, every duration reads --:-- and nothing announces
    # that it went wrong.
    #
    # A search also returns channels, not only videos. They arrive as ie_key
    # YoutubeTab with no duration, and playing one is not a thing - so the
    # first field exists purely to drop them.
    while IFS=$'\t' read -r kind id live duration title; do
        [[ "$kind" == "Youtube" ]] || continue
        [[ -n "$id" && "$id" != "NA" ]] || continue
        if [[ "$live" == "is_live" ]]; then
            badge="LIVE"
        else
            badge="$(fmt_duration "$duration")"
        fi
        ids+=("$id")
        titles+=("$title")
        rows+=("$(printf '%-8s  %s' "$badge" "${title:0:78}")")
    done < <(yt-dlp --flat-playlist --no-warnings \
                --print $'%(ie_key)s\t%(id)s\t%(live_status)s\t%(duration)s\t%(title)s' \
                "ytsearch${SEARCH_RESULTS}:$query" 2>/dev/null || true)

    [[ ${#ids[@]} -gt 0 ]] || die "nothing found for '$query'"

    # -format i returns the position rather than the text, so a title with a
    # tab, a dot or a leading space cannot break the mapping back to its id.
    local index
    index="$(printf '%s\n' "${rows[@]}" |
        rofi -dmenu -i -p 'play' -format i \
             -theme-str "listview { lines: ${#ids[@]}; }" 2>/dev/null || true)"
    # A bare [[ -n ]] is not enough: an array subscript is evaluated as
    # arithmetic, so anything non-numeric arriving here would be read as a
    # variable name rather than rejected.
    [[ "$index" =~ ^[0-9]+$ ]] || exit 0
    (( index < ${#ids[@]} )) || exit 0

    start_playing "${titles[$index]}" \
                  "https://www.youtube.com/watch?v=${ids[$index]}" search
}

# Write the search that found what is playing, never the id it resolved to.
keep_current() {
    [[ -r "$STATE" ]] || die "nothing is playing to keep"

    local kind target label line
    IFS=$'\t' read -r kind target label < "$STATE"
    [[ "$kind" == "search" ]] || die "\"$label\" is already in the list"

    # The title is a better key than the words that happened to find it: it is
    # what the channel calls the thing, so it keeps finding it.
    line="$(printf '%s\tsearch:%s' "$label" "$label")"

    mkdir -p "$(dirname "$LOCAL_STATIONS")"
    if [[ -r "$LOCAL_STATIONS" ]] && grep -qxF "$line" "$LOCAL_STATIONS"; then
        note "\"$label\" is already kept"
        return
    fi

    if [[ ! -e "$LOCAL_STATIONS" ]]; then
        cat > "$LOCAL_STATIONS" <<'HEADER'
# Stations kept on this machine, written by ~/.local/bin/focus-music.
#
# Same format as the tracked list next to it: a name, a TAB, a target. chezmoi
# does not manage this file, so what you keep here is not a repository diff and
# `chezmoi apply` will not clobber it.
#
# Every line written here is a search rather than a link, on purpose - see the
# comments in ~/.local/bin/focus-music. Delete a line to forget it.

HEADER
    fi

    printf '%s\n' "$line" >> "$LOCAL_STATIONS"
    note "Kept \"$label\""
}

# Resolve everything and say what no longer answers.
do_check() {
    read_entries
    [[ ${#TARGETS[@]} -gt 0 ]] || die "no stations to check"

    local i label target kind detail dead=0 code

    printf 'Checking %d station(s).\n\n' "${#TARGETS[@]}"
    for i in "${!TARGETS[@]}"; do
        label="${LABELS[$i]}"
        target="${TARGETS[$i]}"
        detail=""

        case "$target" in
            search:*)
                kind="search"
                if resolve_target "$target" >/dev/null 2>&1; then
                    detail="ok"
                else
                    detail="FOUND NOTHING"
                fi
                ;;
            *youtube.com*|*youtu.be*)
                kind="youtube"
                if yt-dlp --no-warnings --print '%(id)s' "$target" \
                        >/dev/null 2>&1; then
                    detail="ok"
                else
                    detail="GONE"
                fi
                ;;
            *)
                kind="stream"
                # A range request rather than HEAD: icecast answers HEAD
                # inconsistently, and asking for one byte of audio is the same
                # question the player asks.
                code="$(curl -sS --max-time 10 --range 0-1024 \
                            -o /dev/null -w '%{http_code}' "$target" \
                            2>/dev/null || true)"
                case "$code" in
                    2*|3*) detail="ok" ;;
                    ""|000) detail="NO ANSWER" ;;
                    *) detail="HTTP $code" ;;
                esac
                ;;
        esac

        [[ "$detail" == "ok" ]] || dead=$(( dead + 1 ))
        printf '  %-8s %-14s %s\n' "$kind" "$detail" "$label"
    done

    printf '\n'
    if (( dead > 0 )); then
        printf '%d entry/entries did not resolve.\n' "$dead"
        printf 'Tracked ones live in setup/dotfiles/dot_config/focus-music/stations;\n'
        printf 'kept ones in %s\n' "$LOCAL_STATIONS"
        return 1
    fi
    printf 'Everything resolves.\n'
}

usage() {
    cat <<'USAGE'
focus-music [--check]

  (no arguments)  pick a station, search YouTube, or stop what is playing
  --check         resolve every station and report the ones that do not answer
USAGE
}

case "${1:-}" in
    --check) do_check; exit $? ;;
    -h|--help) usage; exit 0 ;;
    "") ;;
    *) die "unknown option '$1' - try --help" ;;
esac

[[ -r "$STATIONS" ]] || die "no station list at $STATIONS"

# Already playing? Then the useful action is to stop, not to open a menu asking
# which station to start a second copy of.
current="$(playing_instance)"
if [[ -n "$current" ]]; then
    title="$(now_playing "$current")"

    # Keeping only means something for a search result; everything else is
    # already written down somewhere.
    menu="Stop"$'\n'"Change station"
    state_kind=""
    if [[ -r "$STATE" ]]; then
        IFS=$'\t' read -r state_kind _ _ < "$STATE" || true
    fi
    [[ "$state_kind" == "search" ]] && menu+=$'\n'"Keep this station"

    lines="$(printf '%s\n' "$menu" | grep -c '')"
    choice="$(printf '%s\n' "$menu" |
        rofi -dmenu -i -p "playing${title:+: ${title:0:40}}" -format s \
             -theme-str "listview { lines: ${lines}; }" 2>/dev/null || true)"
    case "$choice" in
        Stop) stop_playing "$current"; exit 0 ;;
        "Keep this station") keep_current; exit 0 ;;
        "Change station") : ;;   # fall through to the picker
        *) exit 0 ;;
    esac
fi

read_entries
[[ ${#LABELS[@]} -gt 0 ]] || die "the station list has no entries"

# Search sits at the top: it is the entry whose position you learn, and the one
# you reach for when nothing in the list is what you want.
SEARCH_ROW="Search YouTube..."
menu_rows=("$SEARCH_ROW" "${LABELS[@]}")

index="$(printf '%s\n' "${menu_rows[@]}" |
    rofi -dmenu -i -p 'focus music' -format i \
         -theme-str "listview { lines: ${#menu_rows[@]}; }" 2>/dev/null || true)"
[[ "$index" =~ ^[0-9]+$ ]] || exit 0
(( index < ${#menu_rows[@]} )) || exit 0

if (( index == 0 )); then
    do_search
else
    entry=$(( index - 1 ))
    start_playing "${LABELS[$entry]}" "${TARGETS[$entry]}" station
fi
