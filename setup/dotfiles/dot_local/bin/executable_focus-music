#!/usr/bin/env bash
set -euo pipefail

# requires: mpv rofi systemd-run yt-dlp curl python3 pgrep ffmpeg

# Background music, one launcher entry away and then invisible.
#
# Picks a station from ~/.config/focus-music/stations - or searches YouTube for
# whatever you type - and hands the result to mpv, which exposes itself over
# MPRIS, so the bar's media module and the playback keys control it from then on.
#
# WHY IT STARTS mpv IN ITS OWN SCOPE
#
# Launched from rofi, mpv would be a child of whatever spawned it and would sit
# in that process's cgroup. The workspace greeter learned this the expensive
# way: systemd's default KillMode is control-group, so restarting the service
# that happened to spawn something kills it, and a sway crash SIGKILLs anything
# in the compositor's own cgroup ten seconds later. Music that stops when the
# launcher closes, or when an unrelated unit restarts, is not worth having.
#
# systemd-run --scope puts it in a transient scope under app.slice, which is
# where a user application belongs. --collect cleans the scope up when mpv
# exits.
#
# ONE mpv, ADDRESSED BY ITS SOCKET
#
# mpv is started once, idle, listening on a JSON IPC socket, and everything
# afterwards is a message to that socket: queue this, play that now, reorder,
# remove, stop. The queue is mpv's own playlist, so there is no second copy of
# it here that could disagree.
#
# Addressing it by socket also fixed a real bug. Stopping used to be
# `pkill -x mpv`, which kills *every* mpv the user is running - including one
# playing a film in another workspace. Now only the instance holding this
# socket is ever touched.
#
# WHAT IS KEPT IS A SEARCH, NOT A LINK
#
# A station line's second field is either a URL played directly, or the word
# search: followed by text, which is handed to YouTube and resolved to whatever
# it finds now. Everything this script writes down is the second kind, and that
# is deliberate: a video id is a link that rots, and a list of rotted links is
# discovered one silence at a time. A search cannot 404. It also survives the
# failure TASK-145 documented, where a channel restarts its 24/7 broadcast under
# a new id and every recorded id for it dies at once.
#
# Nothing is written down at all unless you ask for it. Searching and playing
# leaves no trace; "Keep this station" is the only writer, and it appends to
# stations.local, which chezmoi does not manage - so keeping something is not a
# repository diff and `chezmoi apply` cannot clobber it.
#
# --check is for the links that genuinely are links: it resolves every entry in
# both files and names the dead ones, so pruning is a decision rather than a
# discovery.

STATIONS="${XDG_CONFIG_HOME:-$HOME/.config}/focus-music/stations"
LOCAL_STATIONS="${XDG_CONFIG_HOME:-$HOME/.config}/focus-music/stations.local"

# The one thing that speaks mpv's IPC. Everything about the queue goes through
# it, for the same reason desktop_config.py is the only writer of chezmoi.toml.
QUEUE_LIB="$HOME/.local/lib/mpv_queue.py"

# Exported so the helper and this script cannot disagree about which mpv they
# mean, and so both can be pointed at a throwaway instance for testing.
FOCUS_MUSIC_SOCKET="${FOCUS_MUSIC_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/focus-music.sock}"
export FOCUS_MUSIC_SOCKET

# How many search results to offer. Enough to choose from, few enough to read
# without scrolling.
SEARCH_RESULTS=15

die() {
    echo "focus-music: $*" >&2
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a focus-music "focus-music" "$*" || true
    exit 1
}

note() {
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a focus-music -t 4000 "focus music" "$1" || true
}

mpvq() {
    python3 "$QUEUE_LIB" "$@"
}

mpv_running() { mpvq running >/dev/null 2>&1; }
mpv_playing() { mpvq playing >/dev/null 2>&1; }

# Music started by the version of this script that predates the queue: an mpv
# carrying a forced title and no IPC socket. Matched that narrowly so an
# unrelated mpv - a film - is never caught by it. Without this, the first play
# after an update would leave two streams running at once.
stop_legacy_mpv() {
    local pid cmdline
    while read -r pid; do
        [[ -r "/proc/$pid/cmdline" ]] || continue
        cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline")"
        [[ "$cmdline" == *--input-ipc-server* ]] && continue
        kill "$pid" 2>/dev/null || true
    # No -x: with -f that would demand the whole command line match exactly,
    # so the pattern would never fire and this would quietly do nothing.
    done < <(pgrep -u "$(id -u)" -f -- '--force-media-title=' 2>/dev/null || true)
}

ensure_mpv() {
    mpv_running && return 0

    stop_legacy_mpv

    # A socket file left behind by an mpv that died is not a listener; connect
    # fails on it exactly as if it were absent, and mpv will not bind a path
    # that already exists.
    rm -f "$FOCUS_MUSIC_SOCKET"

    systemd-run --user --scope --quiet --collect -- \
        mpv --no-terminal --idle=yes \
            --input-ipc-server="$FOCUS_MUSIC_SOCKET" >/dev/null 2>&1 &
    disown

    local waited=0
    while (( waited < 60 )); do
        mpv_running && return 0
        sleep 0.1
        waited=$(( waited + 1 ))
    done
    die "mpv did not come up"
}

# Seconds to something a human reads at a glance. A live stream has no duration
# at all and yt-dlp prints NA for it, which is why the caller decides the badge
# and this only ever sees a recording.
fmt_duration() {
    local s="${1:-}"
    [[ "$s" =~ ^[0-9]+$ ]] || { printf '%s' '--:--'; return; }
    local h=$(( s / 3600 )) m=$(( (s % 3600) / 60 )) sec=$(( s % 60 ))
    if (( h > 0 )); then
        printf '%d:%02d:%02d' "$h" "$m" "$sec"
    else
        printf '%d:%02d' "$m" "$sec"
    fi
}

# Both station files, in order, into parallel arrays. The tracked list first so
# it stays the top of the menu, then whatever this machine has kept.
LABELS=()
TARGETS=()
read_entries() {
    LABELS=()
    TARGETS=()
    local file label target
    for file in "$STATIONS" "$LOCAL_STATIONS"; do
        [[ -r "$file" ]] || continue
        while IFS=$'\t' read -r label target; do
            [[ -n "$label" && -n "$target" ]] || continue
            LABELS+=("$label")
            TARGETS+=("$target")
        done < <(grep -P '^[^#].*\t' "$file" || true)
    done
}

# A target is one of three forms, and prints "url<TAB>kind".
#
#   https://...      a radio stream, which never ends            -> infinite
#   search:<text>    resolved through YouTube on every play      -> finite/infinite
#   noise:<name>     rain, waves, brown noise                    -> loop
#
# The kind is passed to mpv rather than inferred there, because each one needs
# something different at the end of the file. A finite track that keeps mpv open
# leaves the bar showing music that stopped. A noise is a one-minute file that is
# meant never to stop, so it loops rather than advancing the queue.
#
# A noise is made on the machine the first time it is asked for - see
# ~/.local/bin/focus-noise - and played from disk every time after.
resolve_target() {
    local target="$1" query line id live path
    case "$target" in
        noise:*)
            # By absolute path: ~/.local/bin is not on the PATH sway and rofi
            # hand to what they spawn, so a bare name works from a terminal and
            # silently fails from the launcher.
            path="$("$HOME/.local/bin/focus-noise" --path "${target#noise:}" 2>/dev/null)" ||
                return 1
            [[ -s "$path" ]] || return 1
            printf '%s\tloop' "$path"
            ;;
        search:*)
            query="${target#search:}"
            line="$(yt-dlp --flat-playlist --no-warnings \
                        --print $'%(id)s\t%(live_status)s' \
                        "ytsearch1:$query" 2>/dev/null | head -1 || true)"
            [[ -n "$line" ]] || return 1
            IFS=$'\t' read -r id live <<<"$line"
            [[ -n "$id" && "$id" != "NA" ]] || return 1
            if [[ "$live" == "is_live" ]]; then
                printf 'https://www.youtube.com/watch?v=%s\tinfinite' "$id"
            else
                printf 'https://www.youtube.com/watch?v=%s\tfinite' "$id"
            fi
            ;;
        *)
            # A direct URL here is a radio stream, which never ends.
            printf '%s\tinfinite' "$target"
            ;;
    esac
}

# label, target, mode. Resolves, makes sure mpv is up, and hands it over.
play_target() {
    local label="$1" target="$2" mode="$3" resolved url kind

    case "$target" in
        search:*) note "Finding \"$label\"..." ;;
        noise:*)  note "Preparing \"$label\"..." ;;
    esac

    resolved="$(resolve_target "$target")" || die "nothing found for '$label'"
    IFS=$'\t' read -r url kind <<<"$resolved"

    ensure_mpv

    # A queue that has played out leaves its entries in mpv's playlist with
    # nothing current. Starting something new on top of that would pile onto
    # the dead ones and the list would grow for as long as mpv lives, so the
    # finished queue is cleared first. With something actually playing this
    # does not run, and the queue is left alone.
    if ! mpv_playing; then
        mpvq reset >/dev/null 2>&1 || true
    fi

    mpvq add "$mode" "$url" "$label" "$kind" || die "mpv would not take '$label'"

    case "$mode" in
        now)   note "Playing: $label" ;;
        next)  note "Playing next: $label" ;;
        queue) note "Queued: $label" ;;
    esac
}

# Ask only when something is already playing. With nothing on, "play now" is
# the only sensible reading of choosing a station, and a menu would be noise.
ask_mode() {
    local answer
    answer="$(printf 'Play now\nPlay next\nAdd to queue\n' |
        rofi -dmenu -i -p 'and then' -format s \
             -theme-str 'listview { lines: 3; }' 2>/dev/null || true)"
    case "$answer" in
        "Play now")     printf 'now' ;;
        "Play next")    printf 'next' ;;
        "Add to queue") printf 'queue' ;;
        *)              return 1 ;;
    esac
}

# Search results. Sets PICK_LABEL and PICK_TARGET, or returns non-zero.
PICK_LABEL=""
PICK_TARGET=""
do_search() {
    local query
    query="$(printf '' |
        rofi -dmenu -i -p 'search youtube' -format s \
             -theme-str 'listview { lines: 0; }' 2>/dev/null || true)"
    [[ -n "$query" ]] || return 1

    note "Searching YouTube for \"$query\"..."

    local ids=() titles=() rows=()
    local kind id live duration title badge
    # Fields are tab separated with the title last, so a title containing a tab
    # lands in the last variable rather than shifting every column after it.
    #
    # The template is $'...' rather than '...' because yt-dlp does not expand
    # escape sequences itself: with a literal backslash-t every field arrives
    # in the first variable, every duration reads --:-- and nothing announces
    # that it went wrong.
    #
    # A search also returns channels, not only videos. They arrive as ie_key
    # YoutubeTab with no duration, and playing one is not a thing - so the
    # first field exists purely to drop them.
    while IFS=$'\t' read -r kind id live duration title; do
        [[ "$kind" == "Youtube" ]] || continue
        [[ -n "$id" && "$id" != "NA" ]] || continue
        if [[ "$live" == "is_live" ]]; then
            badge="LIVE"
        else
            badge="$(fmt_duration "$duration")"
        fi
        ids+=("$id")
        titles+=("$title")
        rows+=("$(printf '%-8s  %s' "$badge" "${title:0:78}")")
    done < <(yt-dlp --flat-playlist --no-warnings \
                --print $'%(ie_key)s\t%(id)s\t%(live_status)s\t%(duration)s\t%(title)s' \
                "ytsearch${SEARCH_RESULTS}:$query" 2>/dev/null || true)

    [[ ${#ids[@]} -gt 0 ]] || die "nothing found for '$query'"

    # -format i returns the position rather than the text, so a title with a
    # tab, a dot or a leading space cannot break the mapping back to its id.
    local index
    index="$(printf '%s\n' "${rows[@]}" |
        rofi -dmenu -i -p 'play' -format i \
             -theme-str "listview { lines: ${#ids[@]}; }" 2>/dev/null || true)"
    # A bare [[ -n ]] is not enough: an array subscript is evaluated as
    # arithmetic, so anything non-numeric arriving here would be read as a
    # variable name rather than rejected.
    [[ "$index" =~ ^[0-9]+$ ]] || return 1
    (( index < ${#ids[@]} )) || return 1

    PICK_LABEL="${titles[$index]}"
    PICK_TARGET="https://www.youtube.com/watch?v=${ids[$index]}"
    return 0
}

# The station list, with search on top. Sets PICK_LABEL and PICK_TARGET.
pick_something() {
    read_entries
    [[ ${#LABELS[@]} -gt 0 ]] || die "the station list has no entries"

    # Search sits at the top: it is the entry whose position you learn, and the
    # one you reach for when nothing in the list is what you want.
    local rows=("Search YouTube..." "${LABELS[@]}") index
    index="$(printf '%s\n' "${rows[@]}" |
        rofi -dmenu -i -p 'focus music' -format i \
             -theme-str "listview { lines: ${#rows[@]}; }" 2>/dev/null || true)"
    [[ "$index" =~ ^[0-9]+$ ]] || return 1
    (( index < ${#rows[@]} )) || return 1

    if (( index == 0 )); then
        do_search
        return $?
    fi

    local entry=$(( index - 1 ))
    PICK_LABEL="${LABELS[$entry]}"
    PICK_TARGET="${TARGETS[$entry]}"
    return 0
}

# Write the search that found what is playing, never the id it resolved to.
keep_current() {
    local label line
    label="$(mpvq current 2>/dev/null || true)"
    [[ -n "$label" ]] || die "nothing is playing to keep"

    read_entries
    local known
    for known in "${LABELS[@]}"; do
        [[ "$known" == "$label" ]] && die "\"$label\" is already in the list"
    done

    # The title is a better key than the words that happened to find it: it is
    # what the channel calls the thing, so it keeps finding it.
    line="$(printf '%s\tsearch:%s' "$label" "$label")"

    mkdir -p "$(dirname "$LOCAL_STATIONS")"
    if [[ -r "$LOCAL_STATIONS" ]] && grep -qxF "$line" "$LOCAL_STATIONS"; then
        note "\"$label\" is already kept"
        return
    fi

    if [[ ! -e "$LOCAL_STATIONS" ]]; then
        cat > "$LOCAL_STATIONS" <<'HEADER'
# Stations kept on this machine, written by ~/.local/bin/focus-music.
#
# Same format as the tracked list next to it: a name, a TAB, a target. chezmoi
# does not manage this file, so what you keep here is not a repository diff and
# `chezmoi apply` will not clobber it.
#
# Every line written here is a search rather than a link, on purpose - see the
# comments in ~/.local/bin/focus-music. Delete a line to forget it.

HEADER
    fi

    printf '%s\n' "$line" >> "$LOCAL_STATIONS"
    note "Kept \"$label\""
}

# What one entry of the queue can have done to it.
entry_actions() {
    local index="$1" title="$2" answer
    answer="$(printf 'Play this now\nMove up\nMove down\nRemove\nBack\n' |
        rofi -dmenu -i -p "${title:0:40}" -format s \
             -theme-str 'listview { lines: 5; }' 2>/dev/null || true)"
    case "$answer" in
        "Play this now") mpvq play "$index" || true ;;
        "Move up")       (( index > 0 )) && { mpvq move "$index" $(( index - 1 )) || true; } ;;
        "Move down")     mpvq move "$index" $(( index + 2 )) 2>/dev/null || true ;;
        "Remove")        mpvq remove "$index" || true ;;
        *)               return 0 ;;
    esac
}

# The queue itself: what is lined up, what is playing, and what can be done.
queue_menu() {
    local indexes titles rows line index current title choice
    while true; do
        indexes=()
        titles=()
        rows=()
        while IFS=$'\t' read -r index current title; do
            [[ -n "$index" ]] || continue
            indexes+=("$index")
            titles+=("$title")
            if [[ "$current" == "1" ]]; then
                rows+=("$(printf '> %s' "${title:0:76}")")
            else
                rows+=("$(printf '  %s' "${title:0:76}")")
            fi
        done < <(mpvq list 2>/dev/null || true)

        [[ ${#rows[@]} -gt 0 ]] || { note "nothing is queued"; return 0; }

        rows+=("Clear the queue" "Back")

        choice="$(printf '%s\n' "${rows[@]}" |
            rofi -dmenu -i -p 'queue' -format i \
                 -theme-str "listview { lines: ${#rows[@]}; }" 2>/dev/null || true)"
        [[ "$choice" =~ ^[0-9]+$ ]] || return 0
        (( choice < ${#rows[@]} )) || return 0

        if (( choice == ${#rows[@]} - 1 )); then
            return 0                                  # Back
        elif (( choice == ${#rows[@]} - 2 )); then
            mpvq clear || true                        # keeps what is playing
            note "Queue cleared"
            return 0
        else
            entry_actions "${indexes[$choice]}" "${titles[$choice]}"
        fi
    done
}

# Resolve everything and say what no longer answers.
do_check() {
    read_entries
    [[ ${#TARGETS[@]} -gt 0 ]] || die "no stations to check"

    local i label target kind detail dead=0 code

    printf 'Checking %d station(s).\n\n' "${#TARGETS[@]}"
    for i in "${!TARGETS[@]}"; do
        label="${LABELS[$i]}"
        target="${TARGETS[$i]}"
        detail=""

        case "$target" in
            noise:*)
                kind="noise"
                # Deliberately NOT resolved: resolving a noise generates or
                # downloads it, so a check would quietly make every entry it
                # reported on. Whether the recipe exists is the question here,
                # and focus-noise --list answers it without producing anything.
                if "$HOME/.local/bin/focus-noise" --list 2>/dev/null |
                        awk '{print $1}' | grep -qxF "${target#noise:}"; then
                    detail="ok"
                else
                    detail="NO SUCH NOISE"
                fi
                ;;
            search:*)
                kind="search"
                if resolve_target "$target" >/dev/null 2>&1; then
                    detail="ok"
                else
                    detail="FOUND NOTHING"
                fi
                ;;
            *youtube.com*|*youtu.be*)
                kind="youtube"
                if yt-dlp --no-warnings --print '%(id)s' "$target" \
                        >/dev/null 2>&1; then
                    detail="ok"
                else
                    detail="GONE"
                fi
                ;;
            *)
                kind="stream"
                # A range request rather than HEAD: icecast answers HEAD
                # inconsistently, and asking for one byte of audio is the same
                # question the player asks.
                code="$(curl -sS --max-time 10 --range 0-1024 \
                            -o /dev/null -w '%{http_code}' "$target" \
                            2>/dev/null || true)"
                case "$code" in
                    2*|3*) detail="ok" ;;
                    ""|000) detail="NO ANSWER" ;;
                    *) detail="HTTP $code" ;;
                esac
                ;;
        esac

        [[ "$detail" == "ok" ]] || dead=$(( dead + 1 ))
        printf '  %-8s %-14s %s\n' "$kind" "$detail" "$label"
    done

    printf '\n'
    if (( dead > 0 )); then
        printf '%d entry/entries did not resolve.\n' "$dead"
        printf 'Tracked ones live in setup/dotfiles/dot_config/focus-music/stations;\n'
        printf 'kept ones in %s\n' "$LOCAL_STATIONS"
        return 1
    fi
    printf 'Everything resolves.\n'
}

usage() {
    cat <<'USAGE'
focus-music [--check]

  (no arguments)  pick a station, search YouTube, manage the queue, or stop
  --check         resolve every station and report the ones that do not answer
USAGE
}

case "${1:-}" in
    --check) do_check; exit $? ;;
    -h|--help) usage; exit 0 ;;
    "") ;;
    *) die "unknown option '$1' - try --help" ;;
esac

[[ -r "$STATIONS" ]] || die "no station list at $STATIONS"
[[ -r "$QUEUE_LIB" ]] || die "missing $QUEUE_LIB"

# Already playing? Then the useful actions are about what is on, not a bare
# list of stations to start a second copy from.
if mpv_playing; then
    title="$(mpvq current 2>/dev/null || true)"
    count="$(mpvq count 2>/dev/null || echo 0)"
    [[ "$count" =~ ^[0-9]+$ ]] || count=0

    menu=("Stop" "Play something else")
    (( count > 1 )) && menu+=("Queue ($count)" "Skip to next")

    # Keeping only means something for a title that is not already written
    # down somewhere - which is exactly what came out of a search.
    read_entries
    known="no"
    for label in "${LABELS[@]}"; do
        [[ "$label" == "$title" ]] && known="yes"
    done
    [[ "$known" == "no" && -n "$title" ]] && menu+=("Keep this station")

    choice="$(printf '%s\n' "${menu[@]}" |
        rofi -dmenu -i -p "playing${title:+: ${title:0:40}}" -format s \
             -theme-str "listview { lines: ${#menu[@]}; }" 2>/dev/null || true)"

    case "$choice" in
        Stop)                mpvq quit || true; exit 0 ;;
        "Skip to next")      mpvq next || true; exit 0 ;;
        "Keep this station") keep_current; exit 0 ;;
        "Queue "*)           queue_menu; exit 0 ;;
        "Play something else") : ;;                # fall through to the picker
        *) exit 0 ;;
    esac

    pick_something || exit 0
    mode="$(ask_mode)" || exit 0
    play_target "$PICK_LABEL" "$PICK_TARGET" "$mode"
    exit 0
fi

# Nothing playing, but mpv is up and still holding a queue: that queue played
# out. Without this branch the only thing on offer is a bare station picker,
# which is indistinguishable from having crashed and lost everything - and is
# exactly how it was reported.
if mpv_running; then
    finished="$(mpvq count 2>/dev/null || echo 0)"
    [[ "$finished" =~ ^[0-9]+$ ]] || finished=0

    if (( finished > 0 )); then
        menu=("Play something else" "Play the queue again" "Queue ($finished)" "Stop")
        choice="$(printf '%s\n' "${menu[@]}" |
            rofi -dmenu -i -p "finished: $finished track(s)" -format s \
                 -theme-str "listview { lines: ${#menu[@]}; }" 2>/dev/null || true)"
        case "$choice" in
            "Play the queue again") mpvq play 0 || true; exit 0 ;;
            "Queue "*)              queue_menu; exit 0 ;;
            Stop)                   mpvq quit || true; exit 0 ;;
            "Play something else")  : ;;               # fall through
            *) exit 0 ;;
        esac
    fi
fi

# Nothing playing: pick one and start it, with nothing else to ask.
pick_something || exit 0
play_target "$PICK_LABEL" "$PICK_TARGET" now
