#!/usr/bin/env bash
set -euo pipefail

# requires: makoctl rofi python3

# Everything mako is holding, in one list you can act on.
#
# mako has no panel and no tray icon - it draws a notification and then it is
# gone. It does keep them, though: `makoctl list` is what is on screen now and
# `makoctl history` is what has already expired. This puts both behind the same
# launcher used for everything else, so "what did I miss" is a keypress rather
# than something you either caught or did not.

entries="$(
    python3 - <<'PY'
import json, subprocess

def load(cmd):
    try:
        out = subprocess.run(["makoctl", cmd, "-j"], capture_output=True,
                             text=True, check=True).stdout
        data = json.loads(out or "[]")
    except Exception:
        return []
    # mako has returned both a flat list and a {"data": [[...]]} wrapper across
    # versions, so handle either rather than assuming.
    if isinstance(data, dict):
        data = data.get("data", [])
        if data and isinstance(data[0], list):
            data = data[0]
    return data or []

MARK = {"critical": "!", "normal": " ", "low": "·"}

rows = []
for n in load("list"):
    ident = n.get("id")
    if isinstance(ident, dict):
        ident = ident.get("value")
    urg = n.get("urgency", "normal")
    app = n.get("app_name") or "?"
    summary = (n.get("summary") or "").strip()
    body = " ".join((n.get("body") or "").split())
    text = f"{summary} — {body}" if body else summary
    rows.append(f"dismiss:{ident}\t{MARK.get(urg,' ')} {app}: {text}")

for n in load("history"):
    summary = (n.get("summary") or "").strip()
    app = n.get("app_name") or "?"
    rows.append(f"none:0\t· [seen] {app}: {summary}")

print("\n".join(rows))
PY
)"

# Actions always available, listed last so they are out of the way of the
# notifications themselves but always in the same place.
actions=$'dismiss-all:0\tDismiss all\nrestore:0\tRestore the last dismissed\ndnd:0\tToggle do not disturb'

if [[ -n "$entries" ]]; then
    menu="$entries"$'\n'"$actions"
else
    menu=$'none:0\tNothing waiting\n'"$actions"
fi

choice="$(cut -f2- <<<"$menu" | rofi -dmenu -i -p notifications -format i || true)"
[[ -n "$choice" ]] || exit 0

selected="$(sed -n "$((choice + 1))p" <<<"$menu" | cut -f1)"
verb="${selected%%:*}"
id="${selected##*:}"

case "$verb" in
    dismiss)     makoctl dismiss -n "$id" ;;
    dismiss-all) makoctl dismiss --all ;;
    restore)     makoctl restore ;;
    dnd)         makoctl mode -t dnd ;;
    none)        : ;;
esac
