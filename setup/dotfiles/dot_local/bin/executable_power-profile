#!/usr/bin/env bash
set -euo pipefail

# requires: rofi powerprofilesctl upower

# Switches the CPU power profile through power-profiles-daemon. See TASK-140.
#
#   power-profile              the menu
#   power-profile <profile>    set directly, no menu - run `powerprofilesctl
#                               list` to see the exact names this machine has
#
# ONE MENU, TWO BAR MODULES
#
# Rather than a dedicated power-profile button plus a separate battery
# readout - which would double up on a laptop and leave the button orphaned
# on a desktop - this is opened from whichever of waybar's battery module or
# custom/power-profile module is actually present: battery hides itself with
# no hardware (waybar's own "No batteries" behaviour), power-profile-icon
# hides itself when a battery IS present. Exactly one is ever visible. See
# waybar/config.jsonc.tmpl.
#
# WHY THE PROMPT CARRIES BATTERY DETAIL INSTEAD OF -mesg
#
# rofi's -mesg widget is never placed by this repository's theme - "children"
# in config.rasi does not list "message", so text passed via -mesg is
# accepted and never drawn (see the scripting-traps skill). State goes where
# IS placed instead: the prompt and the rows, the same idiom
# ~/.local/bin/bluetooth already uses for "is bluetooth on".
#
# THE MENU IS BUILT FROM `powerprofilesctl list`, NOT A HARDCODED THREE
#
# Not every machine offers all of performance/balanced/power-saver. Caught
# live during TASK-140's own rollout: a machine reporting PlatformDriver
# "placeholder" (no CPU driver support for a performance mode) lists only
# balanced and power-saver, and `powerprofilesctl set performance` there
# errors outright. A hardcoded three-row menu would have offered a row that
# fails silently on click - exactly the "looks configured, does nothing"
# failure this repository keeps finding. So the menu asks the daemon what it
# actually has, every time it opens, rather than assuming.

die() { echo "power-profile: $*" >&2; exit 1; }

# Nice labels for the profile names power-profiles-daemon defines. A name
# outside this set - a future daemon version, unlikely but not impossible -
# falls back to itself rather than dying, so an unrecognised profile still
# works; it just is not prettified.
label_for() {
    case "$1" in
        performance) echo "Performance" ;;
        balanced)    echo "Balanced" ;;
        power-saver) echo "Power Saving" ;;
        *)           echo "$1" ;;
    esac
}

set_profile() { exec powerprofilesctl set "$1"; }

# One line per profile this machine actually has: "1 balanced" if it is the
# current one, "0 power-saver" otherwise. Parsed from `powerprofilesctl
# list` rather than assumed - the detail lines under each profile
# (PlatformDriver: ...) are TitleCase and never match the pattern below, so
# this needs no fixed indentation width to tell them apart.
list_profiles() {
    powerprofilesctl list 2>/dev/null | awk '
        /^\*?[ \t]*[a-z][a-z-]*:$/ {
            cur = ($0 ~ /^\*/) ? "1" : "0"
            name = $0
            gsub(/^\*/, "", name)
            gsub(/^[ \t]+/, "", name)
            gsub(/:$/, "", name)
            print cur, name
        }
    '
}

# The prompt: battery detail when a battery exists, otherwise just "Power".
# Reads upower rather than sysfs directly because upower already computes
# the time-to-empty/time-to-full figure a menu wants to show, in one call.
prompt() {
    local dev info pct time_left
    dev="$(upower -e 2>/dev/null | grep -m1 'battery_BAT' || true)"
    [[ -n "$dev" ]] || { echo "Power"; return; }

    info="$(upower -i "$dev" 2>/dev/null || true)"
    pct="$(awk -F': +' '/percentage:/ {print $2; exit}' <<<"$info")"
    time_left="$(awk -F': +' '/time to (empty|full):/ {print $2; exit}' <<<"$info")"

    if [[ -n "$pct" && -n "$time_left" ]]; then
        echo "$pct - $time_left"
    elif [[ -n "$pct" ]]; then
        echo "$pct"
    else
        echo "Power"
    fi
}

menu() {
    local cur name rows choice
    rows=""
    while read -r cur name; do
        if [[ "$cur" == "1" ]]; then
            rows+="$(label_for "$name") (current)"$'\n'
        else
            rows+="$(label_for "$name")"$'\n'
        fi
    done < <(list_profiles)

    [[ -n "$rows" ]] || die "powerprofilesctl list returned no profiles - is power-profiles-daemon running?"

    choice="$(printf '%s' "$rows" |
        rofi -dmenu -i -p "$(prompt)" -no-custom -replace || true)"
    [[ -n "$choice" ]] || return 0
    choice="${choice% (current)}"

    while read -r cur name; do
        [[ "$(label_for "$name")" == "$choice" ]] && { set_profile "$name"; return; }
    done < <(list_profiles)
}

case "${1:-}" in
    "")        menu ;;
    -h|--help) sed -n '8,10p' "$0" | sed 's/^# \?//' ;;
    *)
        if list_profiles | awk '{print $2}' | grep -qxF "$1"; then
            set_profile "$1"
        else
            die "unknown profile '$1' - run 'powerprofilesctl list' to see what this machine has, or try --help"
        fi
        ;;
esac
