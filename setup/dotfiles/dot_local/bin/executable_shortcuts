#!/usr/bin/env python3
# requires: rofi swaymsg nvim yazi foot thunar

"""A live shortcut panel that follows whatever you are using.

    shortcuts             open the panel in its own window
    shortcuts --panel     the panel itself (what the window runs)
    shortcuts --mode sway print one context
    shortcuts --list      every context, to a terminal

Bound to $mod+? and available from the launcher.

WHY A WINDOW AND NOT A ROFI MODE

It was a rofi mode first, and rofi draws as a layer-shell surface - which means
the compositor will not tile it, float it, move it or let it sit in a corner
while you work. That is fine for a launcher you dismiss in a second and wrong
for a reference you want kept open beside the thing you are learning.

So it is a terminal window, which is what yazi, btop, nmtui and the calendar
already are here: sway can tile or float it, $mod+Shift+space toggles it, and
foot gives it the theme for free.

WHY IT FOLLOWS FOCUS

Because a panel showing the wrong tool's shortcuts is worse than no panel. It
subscribes to sway's window events and redraws when focus moves, so it is
showing neovim's keys while you are in neovim and yazi's the moment you switch.
It ignores focus landing on itself, or it would only ever show its own.
"""

import json
import os
import pathlib
import re
import subprocess
import sys
import time

HOME = pathlib.Path.home()
CACHE = HOME / ".cache" / "shortcuts"

# app_id -> context. The launcher opens on the context matching whatever is
# focused, so a window not listed here simply opens on the desktop tab.
APP_CONTEXT = {
    "foot": "desktop",
    "explorer": "yazi",
    "thunar": "thunar",
    "xdg-terminal": "desktop",
    "org.qutebrowser.qutebrowser": "qutebrowser",
    "monitor": "desktop",
    "calendar": "desktop",
}


def sway_msg(kind):
    try:
        out = subprocess.run(["swaymsg", "-t", kind, "--raw"],
                             capture_output=True, text=True, timeout=5).stdout
        return json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


# ---------------------------------------------------------------------------
# sway
# ---------------------------------------------------------------------------

def sway_shortcuts():
    """Parsed from the config sway loads, with `set $var` expanded.

    DESCRIBED BY THE COMMAND, NOT BY THE COMMENT ABOVE IT.

    Using the preceding comment was the obvious approach and it produced
    nonsense: this config explains its reasoning in paragraphs, so the line
    immediately above a binding is the end of an argument rather than a label.
    `$mod+q` came out as "not frequent and are worth being slightly awkward".

    The command is the one thing that cannot drift from what the key does,
    because it IS what the key does. A trailing `# comment` on the bindsym line
    overrides it, for the few whose command says nothing useful.
    """
    config_dir = HOME / ".config" / "sway"
    files = [config_dir / "config"] + sorted((config_dir / "config.d").glob("*.conf"))

    text = ""
    for f in files:
        try:
            text += f.read_text() + "\n"
        except OSError:
            continue

    variables = dict(re.findall(r"^\s*set\s+(\$\w+)\s+(.*)$", text, re.M))

    # Longest name first, and it is load-bearing. This is a plain string
    # replacement with no word boundary, so a variable whose name is a PREFIX
    # of another corrupts it: $explorer_tui, added beside $explorer in
    # TASK-189, becomes "thunar_tui" if $explorer is substituted first. A
    # prefix can only be shorter than the name containing it, so sorting by
    # descending length is the whole fix. checks/sway-commands.sh had the same
    # bug and the same repair.
    by_length = sorted(variables.items(), key=lambda kv: -len(kv[0]))

    def expand(value):
        # Repeatedly, because variables refer to variables - $explorer_tui is
        # built from foot, and $term from the terminal helper.
        for _ in range(5):
            for name, replacement in by_length:
                value = value.replace(name, replacement)
        return value

    # Commands whose plain text is not a description. Everything else falls
    # through to a light tidy-up, which is usually enough: "focus left" and
    # "fullscreen" already say what they do.
    PHRASES = [
        # The media keys already say what they are on the keycap, so the
        # description is what actually happens - the cap, in particular, which
        # is invisible and the reason wpctl is used instead of pactl.
        (r"^exec wpctl set-mute .*SINK.* toggle$", "Mute or unmute the speakers"),
        (r"^exec wpctl set-mute .*SOURCE.* toggle$", "Mute or unmute the microphone"),
        (r"^exec wpctl set-volume .*5%\+$", "Volume up 5%, capped at 100%"),
        (r"^exec wpctl set-volume .*5%-$", "Volume down 5%"),
        (r"^exec playerctl play-pause$", "Play or pause whatever is playing"),
        (r"^exec playerctl next$", "Skip to the next track"),
        (r"^exec playerctl previous$", "Back to the previous track"),
        (r"^exec playerctl stop$", "Stop playback"),
        (r"^exec brightnessctl set 5%\+$", "Screen brighter"),
        (r"^exec brightnessctl set 5%-$", "Screen dimmer"),
        (r"^kill$", "Close the focused window"),
        (r"^reload$", "Reload the sway config"),
        (r"^fullscreen$", "Fullscreen the focused window"),
        (r"^focus mode_toggle$", "Switch between the tiled and floating layers"),
        (r"^focus parent$", "Select the container holding this window"),
        (r"^move scratchpad$", "Hide the window in the scratchpad"),
        (r"^focus (\w+)$", lambda m: f"Focus {m.group(1)}"),
        (r"^move (left|right|up|down)$",
         lambda m: f"Move the window {m.group(1)}"),
        (r"^workspace number (\d+)$", lambda m: f"Go to workspace {m.group(1)}"),
        (r"^move container to workspace number (\d+)$",
         lambda m: f"Send the window to workspace {m.group(1)}"),
        (r"^workspace prev_on_output$", "Previous workspace"),
        (r"^workspace next_on_output$", "Next workspace"),
        (r"^workspace back_and_forth$", "Back to the last workspace"),
        (r"^scratchpad show$", "Show the scratchpad"),
        (r"^layout toggle split tabbed$", "Toggle tabbed layout"),
        (r'^mode "default"$', "Leave this mode"),
        (r'^mode "(\w+)"$', lambda m: f"Enter {m.group(1)} mode"),
        (r"^resize (\w+) (\w+) .*$", lambda m: f"{m.group(1).title()} {m.group(2)}"),
        (r"^splith?$", "Split horizontally"),
        (r"^splitv$", "Split vertically"),
    ]

    def describe(command):
        for pattern, replacement in PHRASES:
            m = re.match(pattern, command)
            if m:
                return replacement(m) if callable(replacement) else replacement
        if command.startswith("exec "):
            rest = command[5:].strip()
            # A helper of ours describes itself better by name than by path.
            first = rest.split()[0]
            if "/" in first:
                first = os.path.basename(first)
            args = rest.split(maxsplit=1)
            HELPERS = {
                "terminal": "Open a terminal",
                "shortcuts": "This panel",
                "sway-toggle-floating": "Float or tile the focused window",
                "swaynag": "Exit sway (asks first)",
                "qutebrowser": "Open the browser",
            }
            if first in HELPERS:
                return HELPERS[first]
            if first == "sway-screenshot":
                target = {"screen": "whole screen", "region": "a region",
                          "clip": "a region, to the clipboard"}
                which = args[1].strip() if len(args) > 1 else ""
                return f"Screenshot {target.get(which, which)}"
            if len(args) > 1 and not args[1].startswith("-"):
                return f"{first} {args[1]}"[:56]
            return first
        return command[:56]

    entries = []
    for raw in text.split("\n"):
        line = raw.strip()
        m = re.match(r"^bindsym(?:\s+--[\w-]+)*\s+(\S+)\s+(.*)$", line)
        if not m:
            continue
        keys, command = m.groups()
        # A trailing comment wins, for the few commands that say nothing.
        override = None
        if " #" in command:
            command, override = command.split(" #", 1)
            override = override.strip()
        command = expand(command.strip())
        entries.append((expand(keys), override or describe(command)))

    entries.sort(key=lambda e: e[0])
    return entries


# ---------------------------------------------------------------------------
# neovim
# ---------------------------------------------------------------------------

def nvim_shortcuts():
    """Asked of neovim rather than parsed out of its config.

    Cached against the config's modification time, because starting neovim
    costs more than everything else here put together and the answer only
    changes when the config does.

    EVERY lua file, not just init.lua. Stamping on init.lua alone meant a
    mapping added in lua/lsp.lua left the cache valid and the panel showing a
    list that no longer matched the editor - the same failure as hashing
    package.json without the lockfile, and just as quiet.
    """
    config = HOME / ".config" / "nvim"
    mtimes = [f.stat().st_mtime for f in config.rglob("*.lua")]
    if not mtimes:
        return []
    stamp = str(int(max(mtimes)))

    cache_file = CACHE / f"nvim-{stamp}.json"
    if cache_file.exists():
        try:
            return [tuple(x) for x in json.loads(cache_file.read_text())]
        except ValueError:
            pass

    lua = '''
local out = {}
for _, mode in ipairs({ "n", "i", "v", "x", "o", "t" }) do
  for _, m in ipairs(vim.api.nvim_get_keymap(mode)) do
    if not m.lhs:match("^<Plug>") and m.desc and m.desc ~= "" then
      out[#out+1] = { mode = mode, lhs = m.lhs, desc = m.desc }
    end
  end
end
io.write(vim.json.encode(out))
'''
    try:
        res = subprocess.run(["nvim", "--headless", "-c", "lua " + lua, "-c", "quit"],
                             capture_output=True, text=True, timeout=25)
        data = json.loads(res.stdout or "[]")
    except (OSError, ValueError, subprocess.SubprocessError):
        return []

    # One line per key, collapsing the modes a mapping exists in.
    merged = {}
    for item in data:
        key = (item["lhs"], item["desc"])
        merged.setdefault(key, []).append(item["mode"])
    entries = []
    for (lhs, desc), modes in merged.items():
        # neovim reports the leader already expanded, so a leader mapping comes
        # back as a literal leading space - " f" rather than "<leader>f", which
        # renders as a mapping with no key at all.
        if lhs.startswith(" "):
            lhs = "<leader>" + lhs[1:]
        suffix = "" if modes == ["n"] else "  [" + "".join(sorted(modes)) + "]"
        entries.append((lhs + suffix, desc))
    entries.sort(key=lambda e: e[0].lower())

    CACHE.mkdir(parents=True, exist_ok=True)
    for old in CACHE.glob("nvim-*.json"):
        old.unlink(missing_ok=True)
    cache_file.write_text(json.dumps(entries))
    return entries


# ---------------------------------------------------------------------------
# yazi
# ---------------------------------------------------------------------------

def yazi_shortcuts():
    """Ours from keymap.toml, and yazi's own out of the binary.

    yazi compiles its defaults in rather than shipping a file, so they are
    extracted from the executable - which is how the T-is-unbound question was
    answered when that binding was chosen.
    """
    entries = []
    keymap = HOME / ".config" / "yazi" / "keymap.toml"
    try:
        import tomllib
        with open(keymap, "rb") as fh:
            for item in tomllib.load(fh).get("mgr", {}).get("prepend_keymap", []):
                entries.append((item.get("on", "?"), item.get("desc", "")))
    except (OSError, ValueError, ImportError):
        pass

    try:
        blob = subprocess.run(["strings", "-n", "8", "/usr/bin/yazi"],
                              capture_output=True, text=True, timeout=20).stdout
        seen = set()
        for on, run in re.findall(r'\{ on = "([^"]+)", run = "([^"]+)"', blob):
            if on in seen:
                continue
            seen.add(on)
            entries.append((on, run))
    except (OSError, subprocess.SubprocessError):
        pass
    return entries


# ---------------------------------------------------------------------------
# Thunar
# ---------------------------------------------------------------------------

def thunar_shortcuts():
    """Read out of the accel map, which is the same file that defines them.

    Thunar's keys live in ~/.config/Thunar/accels.scm as GtkAccelMap entries.
    An uncommented line is a binding this repository set; a commented one with
    a non-empty key is Thunar's own default, which is exactly the distinction
    worth showing. Anything with an empty key is unbound and skipped.

    Nothing is extracted from the binary here, unlike yazi: Thunar dumps its
    full default map into this file itself the first time it runs, so the file
    already holds both halves.
    """
    entries = []
    accels = HOME / ".config" / "Thunar" / "accels.scm"
    try:
        lines = accels.read_text().splitlines()
    except OSError:
        return entries

    for line in lines:
        m = re.match(r'\s*(;\s*)?\(gtk_accel_path\s+"<Actions>/([^"]+)"\s+"([^"]*)"\)',
                     line)
        if not m:
            continue
        default, action, key = m.group(1), m.group(2), m.group(3)
        if not key:
            continue
        action = action.split("/")[-1].replace("-", " ")
        entries.append((key, action if default else action + "  [ours]"))
    entries.sort()
    return entries


# ---------------------------------------------------------------------------
# The desktop's own surfaces
# ---------------------------------------------------------------------------

def desktop_shortcuts():
    """Things that are not keyboard shortcuts but are the same question.

    Read from the bar's config, so clicking a module is discoverable in the
    same place as pressing a key - which is where anyone would look for it.
    """
    entries = []
    config = HOME / ".config" / "waybar" / "config.jsonc"
    try:
        raw = config.read_text()
        data = json.loads(re.sub(r"^\s*//.*$", "", raw, flags=re.M))
    except (OSError, ValueError):
        return entries

    pretty = {"on-click": "click", "on-click-right": "right click",
              "on-click-middle": "middle click",
              "on-scroll-up": "scroll up", "on-scroll-down": "scroll down"}
    for name, body in data.items():
        if not isinstance(body, dict):
            continue
        for key, command in body.items():
            if key in pretty:
                label = name.replace("sway/", "").replace("_", " ")
                target = os.path.basename(str(command).split()[0])
                entries.append((f"bar: {label} · {pretty[key]}", target))
    entries.sort()
    return entries


CONTEXTS = {
    "sway": ("Desktop keys", sway_shortcuts),
    "nvim": ("Neovim", nvim_shortcuts),
    "yazi": ("Files (yazi)", yazi_shortcuts),
    "thunar": ("Files (Thunar)", thunar_shortcuts),
    "desktop": ("The bar", desktop_shortcuts),
}


# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

def emit(entries):
    """rofi script mode: one row per line, metadata after a NUL.

    Written from python rather than a shell, because a shell variable cannot
    hold a NUL byte - which is exactly how the notification centre's icons
    ended up rendering as literal escape text.
    """
    width = max((len(k) for k, _ in entries), default=0)
    for keys, desc in entries:
        row = f"{keys.ljust(width)}   {desc}"
        sys.stdout.write(row + "\0nonselectable\x1ftrue\n")


def running_in(pid, wanted, depth=0):
    """Is one of `wanted` running inside this window?

    Asked of the process tree rather than of the window title. The obvious
    approach - matching the title - does not work: a foot window running neovim
    reports its title as "foot", because nothing sets it. The process running
    inside the terminal is the thing that actually answers "what am I looking
    at", and it cannot be wrong.
    """
    if depth > 4:
        return None
    try:
        comm = pathlib.Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return None
    if comm in wanted:
        return wanted[comm]
    # /proc rather than pgrep. This runs on a timer now, and spawning a process
    # per node to ask about processes is the kind of thing that shows up as a
    # panel quietly costing a percent of a core.
    try:
        children = pathlib.Path(
            f"/proc/{pid}/task/{pid}/children").read_text().split()
    except OSError:
        return None
    for child in children:
        found = running_in(child, wanted, depth + 1)
        if found:
            return found
    return None


# What is running inside a terminal decides the context, not the terminal.
BY_PROCESS = {"nvim": "nvim", "yazi": "yazi"}


def focused_context():
    tree = sway_msg("get_tree")
    if not tree:
        return "sway"

    def walk(node):
        yield node
        for key in ("nodes", "floating_nodes"):
            for child in node.get(key, []):
                yield from walk(child)

    for node in walk(tree):
        if node.get("focused"):
            by_process = running_in(node.get("pid"), BY_PROCESS) if node.get("pid") else None
            if by_process:
                return by_process
            return APP_CONTEXT.get(node.get("app_id") or "", "sway")
    return "sway"


# ---------------------------------------------------------------------------
# Making keys readable
# ---------------------------------------------------------------------------
#
# "Mod4+Shift+slash" is what sway calls it and not what anyone presses. Two
# separate translations are needed, and the second is the interesting one.
#
# Names: Mod4 is the Super key, Return is Enter, slash is /.
#
# And the keyd swap. /etc/keyd/default.conf makes the physical left Control send
# Alt and the physical left Alt send Control, so a binding on "Ctrl" is pressed
# with the key labelled Alt. Showing the logical name would be correct and
# useless - the point of this panel is to tell you which key to hit. So the
# physical key is shown, and the header says so once rather than every row.
KEY_NAMES = {
    "Mod4": "Super",
    "Mod1": "Ctrl",      # keyd: the physical left Alt sends Control
    "Ctrl": "Alt",       # keyd: the physical left Control sends Alt
    "Control": "Alt",
    "Alt": "Ctrl",
    "Return": "Enter",
    "slash": "/",
    "minus": "-",
    "equal": "=",
    "space": "Space",
    "Print": "PrtSc",
    "Escape": "Esc",
    "XF86AudioRaiseVolume": "Volume up",
    "XF86AudioLowerVolume": "Volume down",
    "XF86AudioMute": "Mute",
    "XF86AudioMicMute": "Mute mic",
    "XF86AudioPlay": "Play/pause",
    "XF86AudioPause": "Play/pause",
    "XF86AudioNext": "Next track",
    "XF86AudioPrev": "Previous track",
    "XF86AudioStop": "Stop",
    "XF86MonBrightnessUp": "Brightness up",
    "XF86MonBrightnessDown": "Brightness down",
}


def pretty_keys(combo):
    parts = combo.split("+")
    return "+".join(KEY_NAMES.get(part, part) for part in parts)


def collapse_runs(entries):
    """Fold "workspace 1..10" into one row.

    Twenty of the desktop's bindings are the same action with a different
    number, and listing each one buries everything else in a panel this size.
    They are folded only when there are at least three, so a genuine pair is
    left alone.
    """
    import collections
    groups = collections.OrderedDict()
    for keys, desc in entries:
        km = re.match(r"^(.*?)(\d)$", keys)
        dm = re.match(r"^(.*?)(\d+)$", desc)
        if km and dm:
            groups.setdefault((km.group(1), dm.group(1)), []).append(
                (km.group(2), dm.group(2), keys, desc))
        else:
            groups.setdefault((keys, desc), None)

    out = []
    for key, members in groups.items():
        if members is None:
            out.append(key)
        elif len(members) < 3:
            out.extend((k, d) for _, _, k, d in members)
        else:
            prefix, desc_prefix = key
            numbers = [m[1] for m in members]
            first, last = members[0][0], members[-1][0]
            out.append((f"{prefix}{first}…{last}",
                        f"{desc_prefix}{min(numbers, key=int)}–{max(numbers, key=int)}"))
    return out


# ---------------------------------------------------------------------------
# The panel
# ---------------------------------------------------------------------------

HELP = "Tab switch · / search · ↑↓ scroll · f follow · q quit"


def panel():
    import curses
    curses.wrapper(_panel)


def _panel(stdscr):
    import curses
    curses.curs_set(0)
    curses.use_default_colors()          # keep foot's background, so the panel
    for i in range(1, 8):                # is as transparent as everything else
        curses.init_pair(i, i, -1)
    ACCENT, MUTED, BOLD = curses.color_pair(6), curses.color_pair(8 % 8), curses.A_BOLD
    MUTED = curses.color_pair(4)

    names = list(CONTEXTS)
    context = focused_context()
    following = True                     # until a tab is chosen by hand
    query, searching, offset = "", False, 0
    cache = {}
    last_check = 0.0

    def entries_for(name):
        if name not in cache:
            title, fetch = CONTEXTS[name]
            rows = fetch()
            if name == "sway":
                rows = collapse_runs([(pretty_keys(k), d) for k, d in rows])
            cache[name] = rows
        return cache[name]

    stdscr.timeout(400)
    while True:
        rows, cols = stdscr.getmaxyx()
        items = [(k, d) for k, d in entries_for(context)
                 if not query or query.lower() in k.lower() or query.lower() in d.lower()]

        body = max(rows - 4, 1)
        offset = max(0, min(offset, max(len(items) - body, 0)))

        stdscr.erase()

        # Tabs, with the current one marked. Clickable and Tab-able, because
        # the automatic guess is sometimes wrong and arguing with it is worse
        # than steering it.
        x = 1
        tab_spans = []
        for name in names:
            label = f" {CONTEXTS[name][0]} "
            if x + len(label) < cols - 1:
                attr = (curses.A_REVERSE | BOLD) if name == context else MUTED
                stdscr.addstr(0, x, label, attr)
                tab_spans.append((x, x + len(label), name))
                x += len(label) + 1

        marker = "following" if following else "pinned"
        if cols > 30:
            stdscr.addstr(0, max(cols - len(marker) - 2, x), marker[:cols - x - 1], MUTED)

        header = f"/{query}" if searching or query else HELP
        stdscr.addstr(1, 1, header[:cols - 2], MUTED)

        width = min(max((len(k) for k, _ in items), default=8), max(cols // 3, 12))
        for row, (keys, desc) in enumerate(items[offset:offset + body]):
            stdscr.addstr(2 + row, 1, keys[:width].ljust(width), ACCENT)
            room = cols - width - 4
            if room > 0:
                stdscr.addstr(2 + row, width + 3, desc[:room])

        if len(items) > body:
            shown = f"{offset + 1}–{min(offset + body, len(items))} of {len(items)}"
            stdscr.addstr(rows - 1, 1, shown[:cols - 2], MUTED)

        stdscr.refresh()

        # Poll for a context change as well as listening for one. Opening
        # neovim inside a terminal that already had focus changes nothing sway
        # can report - no window appeared, none was focused - so an event-only
        # panel keeps showing the shell's shortcuts until you switch away and
        # back. That was the reported bug.
        now = time.time()
        if following and now - last_check > 0.8:
            last_check = now
            live = focused_context()
            if live != context:
                context, offset = live, 0

        try:
            ch = stdscr.getch()
        except KeyboardInterrupt:
            return
        if ch == -1:
            continue

        if searching:
            if ch in (27,):                       # Esc leaves the search
                searching, query = False, ""
            elif ch in (curses.KEY_ENTER, 10, 13):
                searching = False
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                query = query[:-1]
            elif 32 <= ch < 127:
                query += chr(ch)
                offset = 0
            continue

        if ch in (ord("q"), 27):
            return
        elif ch == ord("/"):
            searching, query, offset = True, "", 0
        elif ch == ord("\t") or ch == 9:
            context = names[(names.index(context) + 1) % len(names)]
            following, offset = False, 0
        elif ch == curses.KEY_BTAB:
            context = names[(names.index(context) - 1) % len(names)]
            following, offset = False, 0
        elif ch == ord("f"):
            following = True
            context, offset = focused_context(), 0
        elif ch in (curses.KEY_DOWN, ord("j")):
            offset += 1
        elif ch in (curses.KEY_UP, ord("k")):
            offset = max(offset - 1, 0)
        elif ch == curses.KEY_NPAGE:
            offset += body
        elif ch == curses.KEY_PPAGE:
            offset = max(offset - body, 0)
        elif ch == curses.KEY_HOME:
            offset = 0
        elif ch == curses.KEY_END:
            offset = len(items)
        elif ch == curses.KEY_MOUSE:
            try:
                _, mx, my, _, _ = curses.getmouse()
            except curses.error:
                continue
            if my == 0:
                for x0, x1, name in tab_spans:
                    if x0 <= mx < x1:
                        context, following, offset = name, False, 0
                        break


def main():
    args = sys.argv[1:]

    if args[:1] == ["--mode"]:
        name = args[1] if len(args) > 1 else "sway"
        _, fetch = CONTEXTS.get(name, CONTEXTS["sway"])
        rows = fetch()
        if name == "sway":
            rows = collapse_runs([(pretty_keys(k), d) for k, d in rows])
        emit(rows)
        return

    if args[:1] == ["--list"]:
        for name, (title, fetch) in CONTEXTS.items():
            print(f"\n== {title} ==")
            rows = fetch()
            if name == "sway":
                rows = collapse_runs([(pretty_keys(k), d) for k, d in rows])
            for keys, desc in rows:
                print(f"  {keys:<26} {desc}")
        return

    if args[:1] == ["--panel"]:
        panel()
        return

    me = str(pathlib.Path(__file__).resolve())
    toggle = str(pathlib.Path(me).parent / "sway-toggle-window")
    os.execvp(toggle, [
        toggle, "shortcuts",
        "foot", "--app-id=shortcuts", "--title=Shortcuts",
        "--window-size-chars=68x26",
        "-e", me, "--panel",
    ])


if __name__ == "__main__":
    main()
