#!/usr/bin/env bash
set -euo pipefail

# requires: swaymsg python3

# Places a floating window where there is room, rather than always in the
# middle. Takes the pid of the process whose window should be placed.
#
# Centring everything means two floating windows land exactly on top of one
# another and become impossible to tell apart. Random offsets fix that but
# scatter windows over each other just as often. This scores candidate
# positions by how much they would overlap what is already floating and takes
# the emptiest, falling back toward the centre when the screen is clear - so
# the first window still lands in the middle, and later ones move aside.

pid="${1:?usage: sway-place-floating <pid>}"

exec python3 - "$pid" <<'PYEOF'
import json, subprocess, sys, time

pid = int(sys.argv[1])

def tree():
    return json.loads(subprocess.run(["swaymsg", "-t", "get_tree"],
                                     capture_output=True, text=True,
                                     check=True).stdout)

def find(node, want_pid, floating=False, ws=None):
    """Return (con, workspace_rect, other_floating_rects) for the window."""
    if node.get("type") == "workspace":
        ws = node
    hits = []
    if node.get("pid") == want_pid and floating:
        hits.append((node, ws))
    for child in node.get("nodes", []):
        hits += find(child, want_pid, floating, ws)
    for child in node.get("floating_nodes", []):
        hits += find(child, want_pid, True, ws)
    return hits

def floating_rects(ws, exclude_id):
    out = []
    def walk(node, floating):
        if node.get("pid") and floating and node.get("id") != exclude_id:
            out.append(node["rect"])
        for c in node.get("nodes", []):
            walk(c, floating)
        for c in node.get("floating_nodes", []):
            walk(c, True)
    walk(ws, False)
    return out

def overlap(a, b):
    dx = min(a["x"] + a["width"],  b["x"] + b["width"])  - max(a["x"], b["x"])
    dy = min(a["y"] + a["height"], b["y"] + b["height"]) - max(a["y"], b["y"])
    return dx * dy if dx > 0 and dy > 0 else 0

# The window does not exist the instant foot is launched, so wait for it -
# briefly, and give up rather than hang if it never appears.
deadline = time.time() + 3.0
con = ws = None
while time.time() < deadline:
    hits = find(tree(), pid)
    if hits:
        con, ws = hits[0]
        break
    time.sleep(0.1)

if con is None or ws is None:
    sys.exit(0)

rect, area = con["rect"], ws["rect"]
others = floating_rects(ws, con["id"])

margin = 24
max_x = area["x"] + area["width"]  - rect["width"]  - margin
max_y = area["y"] + area["height"] - rect["height"] - margin
min_x, min_y = area["x"] + margin, area["y"] + margin

centre = ((area["x"] + area["width"]  - rect["width"])  // 2,
          (area["y"] + area["height"] - rect["height"]) // 2)

if max_x <= min_x or max_y <= min_y:
    # Window is nearly as large as the screen; centring is the only sane answer.
    best = centre
else:
    # A coarse grid rather than every pixel: enough positions to find a gap,
    # few enough to score instantly.
    steps = 7
    candidates = []
    for i in range(steps):
        for j in range(steps):
            x = min_x + (max_x - min_x) * i // (steps - 1)
            y = min_y + (max_y - min_y) * j // (steps - 1)
            candidates.append((x, y))
    candidates.append(centre)

    def score(pos):
        x, y = pos
        probe = {"x": x, "y": y, "width": rect["width"], "height": rect["height"]}
        covered = sum(overlap(probe, o) for o in others)
        # Distance from centre breaks ties, so an empty screen still centres
        # and a busy one drifts outward only as far as it needs to.
        drift = abs(x - centre[0]) + abs(y - centre[1])
        return (covered, drift)

    best = min(candidates, key=score)

subprocess.run(["swaymsg", f'[con_id={con["id"]}] move position {best[0]} {best[1]}'],
               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
PYEOF
