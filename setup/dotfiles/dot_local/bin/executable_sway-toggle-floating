#!/usr/bin/env bash
set -euo pipefail

# requires: swaymsg python3

# Floats or tiles the focused window, and gives it the border that goes with
# the state it lands in.
#
# Floating windows get a title bar: they overlap, they move, and a bar gives
# them something to grab and a name to tell them apart by. Tiled windows do
# not: the window list belongs in the bar, not repeated above every window.
#
# sway cannot pair these itself. `floating toggle` and `border` are separate
# commands, and `border toggle` cycles none/normal/pixel blindly rather than
# choosing by state, so a plain toggle leaves a tiled window wearing a title
# bar or a floating one without.
#
# 40-window-rules.conf covers windows that arrive floating; this covers the
# ones made floating afterwards, which is the other half of the same rule.

is_floating() {
    swaymsg -t get_tree | python3 -c '
import json, sys
try:
    tree = json.load(sys.stdin)
except Exception:
    sys.exit(1)

def walk(node, floating):
    if node.get("focused"):
        print("yes" if floating else "no")
        sys.exit(0)
    for child in node.get("nodes", []):
        walk(child, floating)
    for child in node.get("floating_nodes", []):
        walk(child, True)

walk(tree, False)
sys.exit(1)
' 2>/dev/null | grep -qx yes
}

if is_floating; then
    swaymsg 'floating disable, border pixel 4' >/dev/null
else
    swaymsg 'floating enable, border normal 4' >/dev/null
fi
