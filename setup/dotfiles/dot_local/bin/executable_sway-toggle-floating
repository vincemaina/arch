#!/usr/bin/env bash
set -euo pipefail

# requires: swaymsg python3

# Floats or tiles the focused window, and gives it the border that goes with
# the state it lands in.
#
# Nothing here has a title bar - the window list belongs in the bar, not
# repeated above every window - so both states use `border pixel`. The border
# is still set explicitly rather than left alone, because a window that has
# been given `border normal` by hand should come back to the house style when
# its placement changes.

is_floating() {
    swaymsg -t get_tree | python3 -c '
import json, sys
try:
    tree = json.load(sys.stdin)
except Exception:
    sys.exit(1)

def walk(node, floating):
    if node.get("focused"):
        print("yes" if floating else "no")
        sys.exit(0)
    for child in node.get("nodes", []):
        walk(child, floating)
    for child in node.get("floating_nodes", []):
        walk(child, True)

walk(tree, False)
sys.exit(1)
' 2>/dev/null | grep -qx yes
}

if is_floating; then
    swaymsg 'floating disable, border pixel 4' >/dev/null
else
    swaymsg 'floating enable, border pixel 4' >/dev/null
fi
