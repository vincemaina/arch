#!/usr/bin/env bash
set -euo pipefail

# requires: swaymsg python3 systemd-run
#
# `terminal` is deliberately not listed: the requires header is for external
# commands that must come from a declared package, and that one is our own
# helper alongside this script, called by absolute path.

# Opens a greeting terminal whenever an empty workspace is focused, so a fresh
# workspace lands you somewhere useful rather than on a blank screen.
#
# This also covers the start of a session: the unit starts once sway is up, and
# it checks the workspace it finds itself on before waiting for any events.
#
# It cannot loop. The terminal it opens lands on the workspace that triggered
# it, so that workspace is no longer empty. Closing the terminal makes it empty
# again, which is the point - go back to it later and you are greeted again.

exec python3 - <<'PYEOF'
import json, subprocess, sys, os

TERMINAL = os.path.expanduser("~/.local/bin/terminal")

def workspace_is_empty(name):
    """Ask sway, rather than trusting the event payload.

    The event carries a snapshot of the workspace, but a window can arrive
    between the event being sent and this running - `move container to
    workspace` followed by a focus is exactly that shape. Re-querying makes a
    double-open impossible rather than unlikely.
    """
    try:
        tree = json.loads(subprocess.run(
            ["swaymsg", "-t", "get_tree"],
            capture_output=True, text=True, check=True).stdout)
    except Exception:
        return False

    found = []

    def walk(node):
        if node.get("type") == "workspace" and node.get("name") == name:
            found.append(node)
            return
        for child in node.get("nodes", []) + node.get("floating_nodes", []):
            walk(child)

    walk(tree)
    if not found:
        return False
    ws = found[0]
    return not (ws.get("nodes") or ws.get("floating_nodes"))

def focused_workspace():
    try:
        out = subprocess.run(["swaymsg", "-t", "get_workspaces"],
                             capture_output=True, text=True, check=True).stdout
        for ws in json.loads(out):
            if ws.get("focused"):
                return ws.get("name")
    except Exception:
        pass
    return None

# The system summary belongs to landing in a session, not to landing on a
# workspace. It used to run in every card this opened, which meant seeing the
# same summary again on every workspace and every new terminal - TASK-88. The
# first card of the session gets it; the rest are plain terminals.
#
# This process is the session: the unit is PartOf wayland-session@sway.target,
# so it starts when the session does and dies with it. A module-level flag is
# therefore exactly the right lifetime, and needs no state on disk to reset.
#
# Restart=always is the one thing that could undermine that - a crash would
# restart this and greet again. That is the correct behaviour anyway: coming
# back from a crash is landing in a session as far as anyone can tell.
greeted = False

def greet(name):
    global greeted
    if not (name and workspace_is_empty(name)):
        return
    mode = "--greeting" if not greeted else "--floating"
    greeted = True

    # THE TERMINAL MUST NOT BE A CHILD OF THIS SERVICE.
    #
    # Popen alone made every terminal this opened a member of
    # greeting.service's cgroup, and systemd's default KillMode is
    # control-group - so `systemctl --user restart greeting.service` closed
    # every terminal on the machine, including the one the restart was typed
    # into. It did exactly that. Worse, this unit is Restart=always, so a crash
    # here would have taken every open terminal with it, at the moment least
    # convenient for it to happen.
    #
    # systemd-run --scope puts each terminal in its own transient scope under
    # app.slice, which is where a user application belongs anyway - this is a
    # thing that launches terminals, not a thing that owns them. --collect
    # cleans the scope up when it exits, and --quiet keeps the unit name off
    # the journal on every workspace.
    subprocess.Popen(
        ["systemd-run", "--user", "--scope", "--quiet", "--collect",
         TERMINAL, mode],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# The workspace this session started on, before any events arrive.
greet(focused_workspace())

proc = subprocess.Popen(["swaymsg", "-t", "subscribe", "-m", '["workspace"]'],
                        stdout=subprocess.PIPE, text=True)
for line in proc.stdout:
    try:
        event = json.loads(line)
    except ValueError:
        continue
    # "focus" covers both switching to an existing empty workspace and landing
    # on a newly created one; "init" alone would miss the former.
    if event.get("change") != "focus":
        continue
    current = event.get("current") or {}
    greet(current.get("name"))
PYEOF
