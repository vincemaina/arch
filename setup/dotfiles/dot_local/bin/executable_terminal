#!/usr/bin/env bash
set -euo pipefail

# requires: foot fastfetch zsh swaymsg python3

# Opens a terminal.
#
#   terminal              matches whatever is focused: floating if that is,
#                         tiled otherwise
#   terminal --floating   always floating, for the automatic ones
#   terminal --greeting   floating, and greets you with a system summary
#
# THE SUMMARY IS NOW ONCE A SESSION, NOT ONCE A WINDOW
#
# fastfetch used to run in every terminal this opened. That was a deliberate
# choice and it was the wrong one: sway-workspace-greeter opens a card on every
# empty workspace, so the summary appeared again on every workspace and every
# new terminal, and a system summary you have already read is just noise you
# have to scroll past. It now runs for the FIRST card of a session only -
# TASK-88 - which is where it was actually wanted: you land, you see the
# machine, you get on with it.
#
# It still does not live in .zshrc, for the original reason: there it would run
# for nested shells, subshells and ssh sessions too, and would add its time to
# the shell startup the checks measure.
#
# `fastfetch; exec zsh` rather than foot --hold: --hold leaves a dead terminal
# that cannot be typed into. This way the summary scrolls up as you work,
# exactly like any other command you have run.
#
# THE TWO FLOATING app_idS ARE NOT THE SAME
#
# `greeting` is the once-a-session card. `floating-term` is every other floating
# terminal. They were one app_id until TASK-88, which meant a window rule could
# not tell them apart and - much worse - a selector like
# `swaymsg [app_id=greeting] kill` matched most of the terminals on the machine
# including the one being worked in. See TASK-87.

# Inherit the focused window's placement unless told otherwise.
#
# sway cannot express this itself: for_window rules match static criteria -
# app_id, class, title - and know nothing about what is focused when a window
# appears. So the choice has to be made before launching, which means here.
#
# The rule is simply "match what you are looking at": open a terminal from a
# floating one and you get another floating one, open it from a tile and you
# get a tile. Anything already open is a better guide to what is wanted than a
# fixed default.
focused_is_floating() {
    swaymsg -t get_tree 2>/dev/null | python3 -c '
import json, sys

try:
    tree = json.load(sys.stdin)
except Exception:
    sys.exit(1)

def walk(node, floating):
    if node.get("focused"):
        print("yes" if floating else "no")
        sys.exit(0)
    for child in node.get("nodes", []):
        walk(child, floating)
    # Anything below a floating_nodes entry is part of a floating container,
    # so the flag is carried down rather than checked per node.
    for child in node.get("floating_nodes", []):
        walk(child, True)

walk(tree, False)
sys.exit(1)
' 2>/dev/null | grep -qx yes
}

floating=false
greeting=false
case "${1:-}" in
    --greeting) floating=true; greeting=true ;;
    --floating) floating=true ;;
    "")         focused_is_floating && floating=true || true ;;
    *)          echo "usage: terminal [--floating|--greeting]" >&2; exit 2 ;;
esac

# Sized in characters, not pixels, so the grid comes from the font metrics and
# the window fits its contents rather than leaving dead space that shifts with
# any font-size change. fastfetch prints 90 columns by 21 rows; the extra row is
# the prompt underneath. The plain floating terminal keeps the same size so the
# two look like the same kind of object rather than two different cards.
#
# exec'd throughout. This used to launch in the background so the script could
# outlive it and reposition the window; sway-place-floating did that and has
# been taken out - see 40-window-rules.conf for why. Nothing needs to happen
# after the launch any more, so nothing waits around for it.
if $greeting; then
    exec foot \
        --app-id=greeting \
        --title=greeting \
        --window-size-chars=92x23 \
        -e zsh -c 'fastfetch; exec zsh -i'
fi

if $floating; then
    exec foot \
        --app-id=floating-term \
        --title=terminal \
        --window-size-chars=92x23 \
        -e zsh -i
fi

exec foot -e zsh -i
