#!/usr/bin/env bash
set -euo pipefail

# requires: foot ya

# Open a terminal in the directory yazi is showing. Bound to Ctrl+o.
#
# It used to take an optional path, because `o` passed the hovered entry and
# this fell back to the containing directory when that entry was a file. `o`
# now belongs to yazi again (see keymap.toml), so nothing passes anything and
# the fallback went with it - an unreachable branch in a repository whose
# characteristic bug is code that looks configured and does nothing. If a
# terminal-at-the-cursor is ever wanted back, the keymap substitution is `%s1`
# and the two lines to restore here are:
#
#     target="${1:-$PWD}"
#     [[ -d "$target" ]] || target="$(dirname "$target")"
#
# setsid and a background job rather than yazi's own --orphan flag: yazi does
# not validate command flags when it loads a keymap - an invented flag was
# accepted in silence - so a wrong one would fail at the moment the key was
# pressed and nowhere else. These are shell features that are certain.

setsid foot --working-directory="$PWD" >/dev/null 2>&1 &

# And close the file manager behind us. The reason to want a terminal here is
# to do something, and yazi has served its purpose by finding the place -
# leaving it open behind the terminal only means closing it later. Typing
# `yazi` gets you back to the same spot.
#
# `ya emit quit` rather than chaining `quit` in the keymap. The keymap does
# accept an array of commands, and `quit` in one does quit - but it races: the
# shell command never runs at all, measured both with and without --orphan.
# Asking the running instance from here happens after the terminal is already
# started, which is the order that works.
#
# foot is setsid'd above, so it is not in yazi's process group and survives
# yazi exiting a moment later.
exec ya emit quit
