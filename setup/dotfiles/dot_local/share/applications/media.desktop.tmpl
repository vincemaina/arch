# Exec is an absolute path for the same reason focus-music.desktop's is:
# ~/.local/bin is not on the PATH sway and rofi hand to what they spawn, so a
# bare `Exec=media` works when tested from a terminal and silently does nothing
# from the launcher.

[Desktop Entry]
Type=Application
Name=Media Controls
GenericName=Playback controls
Comment=Play, pause, skip and seek whatever is currently playing
Icon=multimedia-player
Exec={{ .chezmoi.homeDir }}/.local/bin/media
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=media;play;pause;next;previous;skip;seek;scrub;position;track;music;
NoDisplay=false
