# Interactive shell configuration.
#
# No framework. Oh My Zsh would add a self-updating git clone, a few hundred
# milliseconds of startup, and a great deal that is never used, in order to
# manage what is a handful of `source` lines. The two plugins that matter are
# packaged, so they are sourced directly and appear in setup/packages/dev.txt
# like everything else.

### History
#
# Large, deduplicated, and shared: a command typed in one terminal is available
# in the next without waiting for a shell to exit.

HISTFILE="$HOME/.local/state/zsh/history"
HISTSIZE=50000
SAVEHIST=50000
mkdir -p "${HISTFILE:h}"

setopt SHARE_HISTORY          # read and write as commands are run, not on exit
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS   # a repeated command keeps only its latest entry
setopt HIST_IGNORE_SPACE      # a leading space keeps a command out of history
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY            # expanded !! is shown before it runs, not after

### Completion

autoload -Uz compinit
# Cache the dump so compinit does not rebuild it on every shell start.
compinit -d "$HOME/.cache/zsh/zcompdump"

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{blue}%d%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh/zcompcache"

setopt AUTO_CD                # `..` and bare directory names change directory
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS

bindkey -e                    # emacs keys: Ctrl+A, Ctrl+E, Ctrl+R as expected

# kill-line is deliberately unbound, and that is a decision rather than a gap.
#
# It was Ctrl+K until TASK-108 took that key for Escape, which moved it to
# Alt+K. TASK-111 then took Alt+K for Up, because Alt+hjkl are now the arrow
# keys - see setup/system/keyd/default.conf. Rather than move it a second time
# it was dropped, on the judgement that it was not actually being used: Ctrl+U
# kills the whole line, Ctrl+W and Alt+Backspace kill the word behind the
# cursor, and Alt+D kills the word ahead. What is genuinely gone is truncating
# a line from the middle to the end, which is the one case none of those cover.
#
# There is deliberately NO bindkey line here. zsh's own emacs keymap still
# binds ^K to kill-line, and keyd turns Ctrl+K into Escape below the
# compositor, so the shell never receives it - kill-line is unreachable on this
# machine by any key at all. To bring it back, bind it somewhere neither
# Alt+hjkl nor Ctrl+K claims; \e^K and \ex are both free. Do not put
# `bindkey '^K'` back, which would read as configuration and could never fire.

### Plugins
#
# Not guarded with a file test. These come from declared packages, so if one is
# missing that is a broken install and should say so on every shell rather than
# silently dropping a feature. checks/session.sh verifies the paths too.

source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

### Tools

eval "$(starship init zsh)"
# --cmd j rather than the default z. Same tool, easier key: z is bottom row
# under the weakest finger, j is home row under the right index, and this is a
# command typed dozens of times a day.
#
# `j <fragment>` jumps to the best match.
eval "$(zoxide init zsh --cmd j)"

# zoxide derives the interactive picker's name from --cmd, so it arrives as
# `ji` and there is no flag to change just that one. zsh can rename a function
# by copying its body out of the `functions` array, which is exact - no alias
# leaving both names live, and no sed against generated code.
#
# jf, for find: `jf <fragment>` lists the candidates to choose from rather than
# jumping straight to the best guess.
functions[jf]=$functions[ji]
unfunction ji

# fzf: Ctrl+R for fuzzy history, Ctrl+T for files, Alt+C to change directory.
source <(fzf --zsh)

export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border=none'

### Aliases

alias ls='eza --group-directories-first'
alias ll='eza -l --git --group-directories-first'
alias la='eza -la --git --group-directories-first'
alias lt='eza --tree --level=2 --group-directories-first'
alias cat='bat --style=plain --paging=never'
alias grep='grep --color=auto'
alias q='exit'

# bat and eza both take their colours from the terminal palette rather than
# carrying their own, so they follow the selected theme for free.
export BAT_THEME=ansi

### The bell, after a long command
#
# TASK-85: "when a terminal has finished executing some long task e.g. claude
# response, or long curl command".
#
# All this does is print \a. Everything else already existed and is worth
# knowing about before changing any of it, because the chain is four pieces
# long and each one is somewhere else:
#
#   zsh    rings the bell here, if the command took long enough
#   foot   [bell] visual=yes flashes the window, and notify=yes raises a
#          desktop notification - but ONLY when the window is unfocused, which
#          is the behaviour that makes this worth having at all
#   mako   receives it as a notification with app-name `foot`
#   mako   [app-name=foot] on-notify runs play-sound complete
#
# So a build finishing on another workspace makes a noise, and one finishing in
# front of you flashes instead. Neither needed new plumbing; the whole
# integration is this hook and one criteria block in mako's config.
#
# WHY A TIME THRESHOLD RATHER THAN EVERY COMMAND
#
# Because a bell on `ls` is a machine nobody can work next to. Twenty seconds
# is long enough that you have almost certainly looked away and short enough to
# catch a slow curl. Override it per-machine in ~/.config/zsh/local.zsh.
: ${LONG_COMMAND_SECONDS:=20}

# Programs that are long by their nature. These are not slow tasks finishing,
# they are you closing an editor, and a bell for each would train you to ignore
# every bell.
#
# `claude` is in this list deliberately, and it is the one entry that looks
# wrong given the ticket asked for it by name. zsh cannot see a response: from
# out here a Claude Code session is one command that runs for an hour, so the
# only thing this hook could ring for is quitting it. Claude Code has its own
# notification setting for the per-response case, and pointing it at the
# terminal bell puts it back on exactly the chain above.
typeset -ga LONG_COMMAND_IGNORE=(
    nvim vim nano less more man btop htop top yazi ssh mosh watch tail
    claude lazygit git-ui fzf ya bluetoothctl nmtui zsh bash sudoedit
)

autoload -Uz add-zsh-hook

_long_command_begin() {
    _long_command_at=$SECONDS

    # (z) splits the line the way the shell would, so the first word is the
    # command rather than the first thing before a space - and :t drops any
    # leading path, so /usr/bin/nvim matches nvim.
    #
    # THE ARRAY IS NOT OPTIONAL. This was `${${${(z)1}[1]}:t}` and it was wrong
    # in a way that returned an answer rather than an error: when the inner
    # expansion yields a SINGLE word, zsh treats it as a scalar and [1]
    # subscripts a character instead of an element. So `make -j8 all` gave
    # `make` and a bare `claude` gave `c` - which matches nothing in the list
    # below, so every ignored program that is run with no arguments quietly
    # rang the bell anyway. Assigning to a declared array forces the array
    # reading in both cases.
    local -a words
    words=(${(z)1})
    _long_command_name=${words[1]:t}
}

_long_command_end() {
    # Unset on the very first prompt of a shell, when nothing has run yet.
    [[ -n ${_long_command_at:-} ]] || return 0

    local elapsed=$(( SECONDS - _long_command_at ))
    local name=$_long_command_name
    unset _long_command_at _long_command_name

    (( elapsed >= LONG_COMMAND_SECONDS )) || return 0
    (( ${LONG_COMMAND_IGNORE[(I)$name]} )) && return 0

    print -n '\a'
}

add-zsh-hook preexec _long_command_begin
add-zsh-hook precmd _long_command_end

### Syntax highlighting
#
# Must be sourced last: it wraps the line editor and needs to see every other
# widget that has been defined.

source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

### PATH
#
# ~/.local/bin holds the helper scripts this repository installs - see
# dot_local/bin/ - alongside anything else installed per-user. Nothing puts it
# on PATH on its own: /etc/profile only appends /usr/local/bin, and the systemd
# user environment does not carry it either. Without this, sway-screenshot and
# sway-idle exist, are executable, and cannot be run by name.
#
# Guarded rather than prepended blindly, so a nested shell does not stack
# duplicate copies onto PATH.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

### Machine-local configuration
#
# Deliberately not managed by chezmoi - see .chezmoiignore, and the "Machine-
# local dotfile changes" entry in DECISIONS.md. Anything that belongs to this
# machine alone goes here, so it never turns a managed file into a conflict at
# sync time.
#
# Sourced last so it can override anything above it. The rule for what belongs
# here: things you are content to lose when the machine is rebuilt. Anything
# else is universal or per-machine-but-declared, and belongs in the repository.
[[ -r "$HOME/.config/zsh/local.zsh" ]] && source "$HOME/.config/zsh/local.zsh"
