#!/usr/bin/env bash
set -euo pipefail

# Build the desktop's sounds, so the first notification after an install makes
# a noise rather than discovering there is nothing to play.
#
# No theme ships audio and nothing image- or audio-shaped is tracked in this
# repository - see ~/.local/bin/sounds for the argument, which is the same one
# ~/.local/bin/wallpaper makes about images. The sounds are computed from the
# tables in that script - one per sound pack, TASK-154 - and cached in
# ~/.local/share/sounds/<pack>/, which is disposable: delete it and the next
# play-sound (or `sounds --ensure`) builds it again.
#
# WHAT MAKES IT RE-RUN
#
# run_onchange_ re-runs a script when the *rendered script* changes, so the line
# below is load-bearing rather than informational. It is a hash of the generator
# itself, which is where every frequency, envelope and level lives - so editing
# a sound rebuilds it, and editing anything else does not. Delete the line and
# changing a sound stops taking effect, which is the "configured and does
# nothing" failure this repository keeps meeting.
#
# recipe: {{ include "dot_local/bin/executable_sounds" | sha256sum }}
#
# Deliberately NOT hashed: ~/.config/sounds, where a file of your own goes.
# That is not part of the repository and putting it here would mean every
# machine with a custom sound rendered a different script.

# Guarded because the installer applies dotfiles in a chroot, where a partially
# built home directory is normal. Generating audio needs no session - it is
# arithmetic and a file write - so unlike a reload there is no reason to skip it
# outside sway.
if [[ ! -x "$HOME/.local/bin/sounds" ]]; then
    exit 0
fi

# --regenerate rather than --ensure. The hash above means this only runs when a
# sound has actually changed, and at that point the cached copies are the OLD
# sounds - which --ensure would leave exactly where they are, having found the
# files present. That is the whole bug this line exists to avoid.
#
# It also, unlike --ensure, covers EVERY pack rather than only the active one -
# on purpose, so editing a pack you are not currently using does not sit stale
# until the day you happen to switch to it. Cheap enough to always do: a dozen
# short WAV files, well under a second even on this VM.
if ! "$HOME/.local/bin/sounds" --regenerate >/dev/null; then
    echo "    could not generate the sounds; run 'sounds --regenerate'" >&2
fi
