{{- $palette := index .themes .theme -}}
#!/usr/bin/env bash
set -euo pipefail

# Make a colour change take effect, rather than only be written.
#
# Nothing on this desktop reads the palette at runtime. Every consumer holds a
# rendered copy of it, so changing a colour - or changing which theme is
# selected - updates files that programs have already read and will not read
# again. Without this, a theme switch leaves the desktop looking exactly as it
# did until each piece is restarted by hand, which is the "configured and does
# nothing" failure this repository keeps meeting.
#
# WHY THIS IS A SCRIPT AND NOT PART OF THE THEME SWITCHER
#
# Because a theme switch is not the only way the colours change. Editing a
# value in .chezmoidata/themes.toml and running sync.sh changes them too, and a
# reload that lived only in ~/.local/bin/theme would not happen then. Here it
# happens for both, because both go through chezmoi.
#
# WHAT MAKES IT RE-RUN
#
# run_onchange_ re-runs a script when the *rendered script* changes, so the four
# lines below are load-bearing rather than informational. The theme name catches
# a switch between themes; the wallpaper name catches a change of style within
# one theme; the glow catches turning the bar's haloes on or off, which changes
# only the stylesheet and would otherwise leave waybar showing the old one; the
# hash catches an edit to the selected theme's colours without any of the names
# changing. None of them is decoration - delete one and this stops running in
# exactly the case it covers.
#
# theme:     {{ .theme }}
# wallpaper: {{ dig "wallpaper" .theme "mesh" . }}
# glow:      {{ dig "glow" .theme $palette.glow . }}
# palette:   {{ toJson $palette | sha256sum }}

# The wallpaper first, and deliberately before the session check below.
#
# No theme ships an image; ~/.local/bin/wallpaper renders one from the theme's
# own colours the first time that theme and style are asked for, and caches it.
# The sway config written moments ago already names the file, so it has to exist
# before sway is told to reload - the other order shows a black desktop for as
# long as the render takes.
#
# Outside the session check because generating an image needs no session, and
# the installer runs this in a chroot where there is no sway at all. Getting
# that wrong would mean every fresh machine's first login had no wallpaper.
if [[ -x "$HOME/.local/bin/wallpaper" ]]; then
    "$HOME/.local/bin/wallpaper" --ensure ||
        echo "    could not generate the wallpaper; run 'wallpaper --regenerate'" >&2
fi

# chezmoi runs scripts wherever it is pointed, including at a scratch
# destination - rendering to /tmp to preview a template is NOT a dry run, which
# CLAUDE.md says in as many words. Reloading a session that is not there is
# meaningless, so having no sway to talk to is a reason to stop rather than a
# problem to report.
if [[ -z "${SWAYSOCK:-}" ]]; then
    exit 0
fi

echo "    Colours changed, reloading the session"

# sway rereads its config, which also restarts swaybg, so the wallpaper follows
# without being handled separately.
if ! swaymsg reload >/dev/null; then
    echo "    sway did not reload; run 'swaymsg reload'" >&2
fi

# mako has a reload command and keeps the notifications it is holding.
if command -v makoctl >/dev/null && ! makoctl reload 2>/dev/null; then
    echo "    mako did not reload; run 'makoctl reload'" >&2
fi

# waybar has no reload. SIGUSR2 re-reads the config in recent versions but not
# the stylesheet, which is the file that actually carries the colours, so the
# unit is restarted instead. It comes back in well under a second.
if systemctl --user is-active --quiet waybar.service; then
    systemctl --user restart waybar.service ||
        echo "    waybar did not restart; run 'systemctl --user restart waybar'" >&2
fi

# GTK, which follows the theme's `mode` rather than its colours.
#
# gtk-3.0/settings.ini was rendered moments ago and every GTK process reads it
# when it starts, so anything launched from here on is already correct and needs
# nothing - pavucontrol, and any dialog rofi or a file manager opens.
#
# Two do not get that chance, because they are started once and stay: the polkit
# authentication dialog is drawn by the agent, and the GTK file chooser is drawn
# by the portal. Both would keep the old mode until the next login, which is
# most of a session, and both are ordinary user units - so they are restarted
# here for exactly the reason waybar is.
#
# Restarting them is cheap and they are re-activated on demand, so nothing is
# lost by doing it on a dark-to-dark switch where GTK did not actually change.
# What it costs, in the rare case it lands at the wrong moment, is an open file
# chooser or a pending password prompt closing - which is a dialog to reopen,
# not work to redo.
for unit in polkit-agent.service xdg-desktop-portal-gtk.service; do
    if systemctl --user is-active --quiet "$unit"; then
        systemctl --user restart "$unit" ||
            echo "    $unit did not restart; run 'systemctl --user restart $unit'" >&2
    fi
done

# Neovim, which CAN be told, and for a while was assumed not to be.
#
# Every neovim listens on a socket whether or not it was asked to - v:servername
# is set even for a headless one - so a running editor is reachable at
# $XDG_RUNTIME_DIR/nvim.<pid>.0 without any configuration. That is the whole
# reason this is possible; the assumption that the editor would have to be
# restarted, the way foot does, was simply wrong.
#
# --remote-expr rather than --remote-send, because send types the keys into
# whatever mode the editor is in: an editor sitting in insert mode would get
# ':colorscheme arch' inserted into the file. expr evaluates and returns instead,
# touching no buffer and no mode.
#
# Sockets outlive the process that made them, so most of what matches this glob
# on a long-running machine is dead. Connecting to a dead one fails immediately
# and is not worth reporting - only a live editor refusing is interesting, and
# there is no way to tell the two apart from out here, so neither is reported.
nvim_reloaded=0
for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*.0; do
    [[ -S "$sock" ]] || continue
    if nvim --server "$sock" --remote-expr "execute('colorscheme arch')" \
            >/dev/null 2>&1; then
        nvim_reloaded=$((nvim_reloaded + 1))
    fi
done
if (( nvim_reloaded > 0 )); then
    echo "    neovim: $nvim_reloaded running editor(s) picked up the new colours"
fi

# Deliberately not handled, because they need nothing:
#
#   rofi, swaylock  read their configuration every time they are launched.
#   starship        reads starship.toml per prompt, so the next prompt has it.
#
# And one that cannot be handled: foot rereads nothing. Its SIGUSR1 switches
# between the [colors-dark] and [colors-light] sections already in the config,
# which is a different thing from reloading the file, so there is no signal that
# would help. Terminals already open keep the colours they started with.
if pgrep -x foot >/dev/null; then
    echo "    foot: open terminals keep their colours; new ones use the new theme"
fi
